<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:views="clr-namespace:VDF.GUI.Views;assembly=VDF.GUI">

  <!-- The mockup's section card + option row, shared by the settings page and the
       setup page. Both group their options the same way, so the two pages cannot
       drift apart: one card style, one row template, one hover surface. -->

  <!-- One card per section: the mockup's card surface with its hairline edge, rows
       separated by the same hairline inside it. The page behind is a step darker, so
       the cards read as cards.
       Both colors come from the palette, not from the theme's container brushes: the
       theme's container border is roughly three times the mockup's line and turns the
       card into a heavy frame around every section, which is the one thing about this
       page that read as cheap. -->
  <Style Selector="Border.setcard">
    <Setter Property="Background" Value="{DynamicResource VdfCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- The mockup's .card radius (the r-lg token), not the theme's smaller default:
         the cards are the page's main shapes and read as sheets at this size. -->
    <Setter Property="CornerRadius" Value="20" />
    <!-- Elevation, not decoration. The card lifts off the page, and the two part
         shadow is what says so (see VdfCardShadow); the hairline edge alone is too
         faint against a page this light. Nothing about a card's state adds a second
         shadow: a shadow under the current one would read as a glow, not depth. -->
    <Setter Property="BoxShadow" Value="{DynamicResource VdfCardShadow}" />
    <!-- No vertical padding of its own. It was 6px top and bottom, and that band was
         the one thing the row's hover surface could not cover: on the first and last
         rows the highlight stopped 6px short of the card's inner wall and left a strip
         of plain card between it and the hairline, which reads as a highlight that
         missed part of the row it belongs to. The mockup's .card has no padding either
         - the rows and the header carry their own - so the band bought nothing.
         The cost is on the two cards that are not row stacks: the scanning page's card
         content sits in its own 30,32 margin and so gets 12px shorter. The page is a
         centred column, so that reads as the mockup, not as a loss. -->
    <Setter Property="Padding" Value="0" />
    <!-- The mockup's .stack gap (14px), which is the distance between two cards. It was
         18px, so every page stacked its cards 4px further apart than the mockup drew. -->
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <!-- Card header: title + optional description on the left, an action on the right
       (mockup .card-head: 17px 20px). Rows inside the card carry their own padding. -->
  <Style Selector="Border.cardhead">
    <Setter Property="Padding" Value="20,17" />
    <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.cardtitle">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.carddesc">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Opacity" Value="{DynamicResource VdfTextDim70Opacity}" />
  </Style>

  <!-- One card per scan profile: radio, name, note. The surface is the selection, so
       backgrounds stay inside the palette that the contrast tests already walk: the
       note keeps VdfMutedBrush (4.54 on the selected fill), and none of these states
       needs a second tone behind the text. The selected card deliberately has no
       pointerover rule of its own: stepping the fill one notch darker drops the note
       to 4.28, below the 4.5 the small print has to hold. -->
  <Style Selector="Border.profilecard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource VdfMutedBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.profilecard:pointerover">
    <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
  </Style>
  <Style Selector="Border.profilecard.active">
    <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VdfRowSelectedFrameBrush}" />
  </Style>

  <!-- one option per row: title + always-visible description left, control right -->
  <Style Selector="views|SettingRow">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <!-- The row carries the pointer-over surface; the hairline below it stays
               full width (mockup .row + .row:hover).
               The surface runs the card's full width and is a plain rectangle, because
               that is what the mockup draws: .row:hover is a bare background with no
               border-radius on it, and .card carries no overflow:hidden either, so on the
               first and last rows the reference's own highlight does run into the card's
               20px shoulder. The 12px corner was there to stay inside that shoulder, and
               it is the one thing wrong with the surface - a highlight smaller than the
               row it highlights reads as "选中没覆盖整个选项", the same complaint that put
               the surface on the card's full width in the first place. The overlap costs
               nothing: #F1F5F9 on #FFFFFF is a 3% step, invisible at any viewing distance.
               Clipping the card to its corner was the other way to hide it and was
               rejected - ClipToBounds applies to the card's whole rendering, VdfCardShadow
               included, and the shadow is doing more work here than the 3% is.
               The card no longer pads itself vertically (see Border.setcard), so the
               surface reaches the card's inner wall exactly on the first and last rows:
               no band of bare card colour between the highlight and the card's edge. -->
          <Border Name="RowSurface"
                  Margin="0"
                  Padding="20,15"
                  Background="Transparent"
                  CornerRadius="0">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2" VerticalAlignment="Center">
                <!-- mockup .row-name (13.5px/550) and .row-note (12px): the row's own
                     two sizes, a step below the card title above it. -->
                <TextBlock FontSize="13.5" FontWeight="550" TextWrapping="Wrap"
                           Text="{TemplateBinding Title}" />
                <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim70Opacity}" TextWrapping="Wrap" MaxWidth="470"
                           HorizontalAlignment="Left"
                           Text="{TemplateBinding Description}"
                           IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock FontSize="12.5" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"
                           Foreground="{DynamicResource VdfWarnBrush}"
                           Text="{TemplateBinding Warning}"
                           IsVisible="{TemplateBinding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Border>
          <Border Height="1" Background="{DynamicResource VdfCardLineBrush}"
                  IsVisible="{TemplateBinding ShowSeparator}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="views|SettingRow:pointerover /template/ Border#RowSurface">
    <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
  </Style>
  <Style Selector="views|SettingRow:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- The mockup's switch: a 42x24 pill with an 18px round knob. The two theme
       tracks differ in lightness so the state reads at a glance (the mockup calls
       this out). PART_SwitchKnob is a Canvas whose width IS the knob travel: the
       control sets Canvas.Left on PART_MovingKnobs to that width, so it is sized
       to the distance the knob actually moves (42 minus 18 minus twice 3).
       Lives here and not on the settings page, because the setup page uses the
       same switches and the theme default prints "On" / "Off" next to them. -->
  <Style Selector="ToggleSwitch.plain">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Grid Grid.Column="0" Width="42" Height="24" VerticalAlignment="Center">
            <Border x:Name="VdfSwitchTrack"
                    Width="42" Height="24" CornerRadius="12"
                    Background="{DynamicResource VdfSwitchTrackOffBrush}" />
            <Canvas x:Name="PART_SwitchKnob"
                    Width="18" Height="24" Margin="3,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
              <Grid x:Name="PART_MovingKnobs" Width="18" Height="24">
                <Ellipse Width="18" Height="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{DynamicResource VdfSwitchKnobBrush}" />
              </Grid>
            </Canvas>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch.plain:checked /template/ Border#VdfSwitchTrack">
    <Setter Property="Background" Value="{DynamicResource VdfSwitchTrackOnBrush}" />
  </Style>

  <!-- Compact numeric field used inside a SettingRow's control slot. -->
  <Style Selector="NumericUpDown.stepper">
    <Setter Property="Width" Value="150" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <!-- The two step buttons are built by the control's template, not written here, and
       they inherit the control's own class: the NumericUpDown carries "stepper", and the
       ButtonSpinner and both RepeatButtons come out wearing it too. That is what these
       selectors key on. Left alone they took the theme's grey fill and frame under the
       pointer, which is the one thing the mockup never puts behind a button. -->
  <Style Selector="RepeatButton.stepper">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="RepeatButton.stepper:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
  </Style>

  <!-- The mockup's slider (page 1, 匹配强度): a 6px sunken track, the filled part a
       soft accent gradient that ends at the knob, and a 20px white knob ringed in
       the accent-active tone. The theme's default slider is a dark grey line with
       a small dark dot, which is the single loudest detail miss on the page.
       Track fills DecreaseButton on the left of the knob and IncreaseButton on
       the right, so the gradient border is the fill and the flat border behind
       it is the rest of the track. -->
  <Style Selector="Slider.mock">
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel VerticalAlignment="Center">
          <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                  Background="{DynamicResource VdfSliderTrackBrush}" />
          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.DecreaseButton>
              <RepeatButton Focusable="False" IsTabStop="False">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource VdfSliderFillBrush}" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Focusable="False" IsTabStop="False">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb Width="20" Height="20" Focusable="False">
              <Thumb.Template>
                <ControlTemplate>
                  <Ellipse Fill="{DynamicResource VdfSwitchKnobBrush}"
                           Stroke="{DynamicResource VdfSliderKnobBorderBrush}"
                           StrokeThickness="2" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
