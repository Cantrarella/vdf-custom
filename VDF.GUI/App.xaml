<Application
    x:Class="VDF.GUI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:generation="clr-namespace:ActiproSoftware.UI.Avalonia.Themes.Generation;assembly=ActiproSoftware.Avalonia.Shared"
    xmlns:local="clr-namespace:VDF.GUI"
    xmlns:utils="clr-namespace:VDF.GUI.Utils"
    RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Exact redesign palette (vdf-ux-concept.html tokens). These are the
                     mockup's good/warn/danger/sel roles; the ACCENT itself comes from
                     the VdfAccent ramp below. Border brushes carry the mockup's 45% alpha so
                     badges/chips survive selected-row backgrounds (locked decision 12). -->
                <ResourceDictionary x:Key="Light">
                    <!-- Text tones are darker than the mockup's (#1C8A52 / #A06A10 / #BB4237):
                         those reached only 3.4 to 4.4:1 on white, on their own soft chips and
                         on the checked-row tint. WCAG AA wants 4.5:1. Borders keep the
                         mockup tone, they are not text. -->
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#16703F" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#E2F2E9" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#731C8A52" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#855709" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#F6ECD9" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#73A06A10" />
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#A5332A" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#F7E5E3" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#73BB4237" />
                    <!-- Checked-row tint: the mockup's row-sel blue (#E8F4FF). Checked means
                         "will be deleted", but the state is carried by the tick itself, so the
                         row tint stays in the accent family and follows the theme. Active =
                         the checked row is ALSO list-selected: the opaque checked tint covers
                         the ListBoxItem highlight, so selection needs its own stronger step. -->
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#E8F4FF" />
                    <!-- The mockup's row-sel-hover step (#DCECFD). The selected row is marked
                         by its frame as well. -->
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#DCECFD" />
                    <!-- The list-selected row: a quiet tint under text that keeps its colors,
                         and a frame. -->
                    <SolidColorBrush x:Key="VdfRowSelectedBrush" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="VdfRowSelectedFrameBrush" Color="#4A97CD" />
                    <!-- Text of a selected list item under the pointer. -->
                    <SolidColorBrush x:Key="VdfSelectedHoverTextBrush" Color="#17587F" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#A93B31" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#8A9793" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#F8FCFF" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#DCE8F5" />
                    <!-- Accent-colored text on a soft accent surface (selected settings section,
                         drive chip, outline accent buttons). The mockup's accent ink. -->
                    <SolidColorBrush x:Key="VdfAccentTextBrush" Color="#17587F" />
                    <!-- Text on the solid accent (Scan, Next group). -->
                    <SolidColorBrush x:Key="VdfOnAccentBrush" Color="#0F3A55" />
                    <!-- Solid red behind white text (Delete checked): the theme's #EE4343 is 3.8:1. -->
                    <SolidColorBrush x:Key="VdfDangerSolidBrush" Color="#D32F2F" />
                    <!-- Dimmed secondary text. Dark keeps the mockup's 0.55 / 0.6 / 0.65, which
                         read 5:1 and better as light-on-dark. The same values as dark-on-white
                         are 3.3 to 4.4:1, so the light theme dims less. -->
                    <x:Double x:Key="VdfTextFaintOpacity">0.72</x:Double>
                    <x:Double x:Key="VdfTextMutedOpacity">0.72</x:Double>
                    <x:Double x:Key="VdfTextSoftOpacity">0.72</x:Double>
                    <x:Double x:Key="VdfTextSecondaryOpacity">0.9</x:Double>
                    <!-- Dimmed text by its value. The same in light and dark, so nothing changes
                         there; what matters is that the high contrast themes set all of them
                         to 1: dimming is contrast taken away on purpose. -->
                    <x:Double x:Key="VdfTextDim90Opacity">0.9</x:Double>
                    <x:Double x:Key="VdfTextDim85Opacity">0.85</x:Double>
                    <x:Double x:Key="VdfTextDim80Opacity">0.8</x:Double>
                    <x:Double x:Key="VdfTextDim75Opacity">0.75</x:Double>
                    <x:Double x:Key="VdfTextDim70Opacity">0.7</x:Double>
                    <x:Double x:Key="VdfTextDim55Opacity">0.55</x:Double>
                    <!-- Placeholder text in an empty field: the theme's own look. -->
                    <x:Double x:Key="VdfPlaceholderOpacity">0.67</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#45B878" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#17301F" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#7345B878" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#D29A3A" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#33260E" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#73D29A3A" />
                    <!-- lighter than the mockup's #E06A5E, which is 4.3:1 on the checked-row tint -->
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#EB8378" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#391914" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#73E06A5E" />
                    <!-- Checked-row tint: the mockup's row-sel over the dark surface
                         (rgba(205,233,255,.12) on #16212E). The state is carried by the
                         tick itself, so the row tint stays in the accent family. Active =
                         the checked row is ALSO list-selected: the opaque checked tint
                         covers the ListBoxItem highlight, so selection needs its own
                         stronger step. -->
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#22303F" />
                    <!-- The mockup's row-sel-hover step (rgba(205,233,255,.18)). The selected
                         row is marked by its frame as well. -->
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#2A3B4D" />
                    <!-- The list-selected row: a quiet tint under text that keeps its colors,
                         and a frame. -->
                    <SolidColorBrush x:Key="VdfRowSelectedBrush" Color="#223040" />
                    <SolidColorBrush x:Key="VdfRowSelectedFrameBrush" Color="#CDE9FF" />
                    <!-- Text of a selected list item under the pointer: the accent is pale, so
                         the text on it goes dark. -->
                    <SolidColorBrush x:Key="VdfSelectedHoverTextBrush" Color="#0B1F2E" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#C05248" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#6D7B76" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#1C2836" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#2C3A4A" />
                    <SolidColorBrush x:Key="VdfAccentTextBrush" Color="#CDE9FF" />
                    <!-- The accent is pale, so the text on it goes dark. -->
                    <SolidColorBrush x:Key="VdfOnAccentBrush" Color="#0B1F2E" />
                    <SolidColorBrush x:Key="VdfDangerSolidBrush" Color="#D32F2F" />
                    <x:Double x:Key="VdfTextFaintOpacity">0.55</x:Double>
                    <x:Double x:Key="VdfTextMutedOpacity">0.6</x:Double>
                    <x:Double x:Key="VdfTextSoftOpacity">0.65</x:Double>
                    <x:Double x:Key="VdfTextSecondaryOpacity">0.7</x:Double>
                    <!-- Dimmed text by its value. The same in light and dark, so nothing changes
                         there; what matters is that the high contrast themes set all of them
                         to 1: dimming is contrast taken away on purpose. -->
                    <x:Double x:Key="VdfTextDim90Opacity">0.9</x:Double>
                    <x:Double x:Key="VdfTextDim85Opacity">0.85</x:Double>
                    <x:Double x:Key="VdfTextDim80Opacity">0.8</x:Double>
                    <x:Double x:Key="VdfTextDim75Opacity">0.75</x:Double>
                    <x:Double x:Key="VdfTextDim70Opacity">0.7</x:Double>
                    <x:Double x:Key="VdfTextDim55Opacity">0.55</x:Double>
                    <!-- Placeholder text in an empty field: the theme's own look. -->
                    <x:Double x:Key="VdfPlaceholderOpacity">0.67</x:Double>
                </ResourceDictionary>
                <!-- High contrast on dark. Held to 7:1 for text (4.5:1 large text and icons) by the contrast guard: no dimmed text at all, tones light enough for the darkest and the tinted surfaces alike, and outlines one can see. -->
                <ResourceDictionary x:Key="{x:Static utils:VdfThemes.HighContrastDark}">
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#8CE6B0" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#0F2418" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#8CE6B0" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#F5C76E" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#2A1F08" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#F5C76E" />
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#FFB3A8" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#2E1210" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#FFB3A8" />
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#1B3040" />
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#24405A" />
                    <SolidColorBrush x:Key="VdfRowSelectedBrush" Color="#16303F" />
                    <SolidColorBrush x:Key="VdfRowSelectedFrameBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfSelectedHoverTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#8A2A22" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#C8CDD4" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#1C2836" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#C8CDD4" />
                    <SolidColorBrush x:Key="VdfAccentTextBrush" Color="#CDE9FF" />
                    <SolidColorBrush x:Key="VdfOnAccentBrush" Color="#000000" />
                    <SolidColorBrush x:Key="VdfDangerSolidBrush" Color="#9E1B1B" />
                    <x:Double x:Key="VdfTextFaintOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextMutedOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextSoftOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextSecondaryOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim90Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim85Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim80Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim75Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim70Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim55Opacity">1</x:Double>
                    <!-- At full strength; the theme's italic still tells it from typed text. -->
                    <x:Double x:Key="VdfPlaceholderOpacity">1</x:Double>
                    <!-- The theme's own surfaces and outlines, where they fall short of the
                         enhanced level: the soft accent surface under text, and the hairline
                         borders that tell a field, a button or a panel from what is around it. -->
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushSoftAccent}" Color="#12304A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushSoftAccentPointerOver}" Color="#12304A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushSoftAccentPressed}" Color="#12304A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushOutlineAccentPointerOver}" Color="#12304A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushOutlineAccentPressed}" Color="#12304A" />
                    <!-- A selected item in a plain list: the inversion high contrast users know as
                         highlight and highlight text. Seen at a glance, and far above 7:1. -->
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemBackgroundBrushSelected}" Color="#CDE9FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemBackgroundBrushSelectedPointerOver}" Color="#CDE9FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemBackgroundBrushSelectedPressed}" Color="#CDE9FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemForegroundBrushSelected}" Color="#000000" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container1BorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container2BorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container3BorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container4BorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container5BorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ButtonBorderBrushOutline}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBorderBrushOutline}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey EditBorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey SwitchBorderBrushOutline}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListBorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey MenuPopupBorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey PopupBorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ToolTipBorderBrush}" Color="#B4B8C0" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ProgressBarBorderBrush}" Color="#B4B8C0" />
                </ResourceDictionary>
                <!-- High contrast on light, the counterpart of the above. -->
                <ResourceDictionary x:Key="{x:Static utils:VdfThemes.HighContrastLight}">
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#0A4A27" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#EAF6EF" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#0A4A27" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#553600" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#FAF2E2" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#553600" />
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#7A1710" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#FBECEA" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#7A1710" />
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#DCECFD" />
                    <SolidColorBrush x:Key="VdfRowSelectedBrush" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="VdfRowSelectedFrameBrush" Color="#000000" />
                    <SolidColorBrush x:Key="VdfSelectedHoverTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#8A2A22" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#3F4650" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#F8FCFF" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#3F4650" />
                    <SolidColorBrush x:Key="VdfAccentTextBrush" Color="#0B3D5C" />
                    <SolidColorBrush x:Key="VdfOnAccentBrush" Color="#000000" />
                    <SolidColorBrush x:Key="VdfDangerSolidBrush" Color="#9E1B1B" />
                    <x:Double x:Key="VdfTextFaintOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextMutedOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextSoftOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextSecondaryOpacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim90Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim85Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim80Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim75Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim70Opacity">1</x:Double>
                    <x:Double x:Key="VdfTextDim55Opacity">1</x:Double>
                    <!-- At full strength; the theme's italic still tells it from typed text. -->
                    <x:Double x:Key="VdfPlaceholderOpacity">1</x:Double>
                    <!-- The theme's own surfaces and outlines, where they fall short of the
                         enhanced level: the soft accent surface under text, and the hairline
                         borders that tell a field, a button or a panel from what is around it. -->
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushSoftAccent}" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushSoftAccentPointerOver}" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushSoftAccentPressed}" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushOutlineAccentPointerOver}" Color="#E8F4FF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBackgroundBrushOutlineAccentPressed}" Color="#E8F4FF" />
                    <!-- A selected item in a plain list: the inversion high contrast users know as
                         highlight and highlight text. Seen at a glance, and far above 7:1. -->
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemBackgroundBrushSelected}" Color="#0B3D5C" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemBackgroundBrushSelectedPointerOver}" Color="#0B3D5C" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemBackgroundBrushSelectedPressed}" Color="#0B3D5C" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListItemForegroundBrushSelected}" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container1BorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container2BorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container3BorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container4BorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey Container5BorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ButtonBorderBrushOutline}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ControlBorderBrushOutline}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey EditBorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey SwitchBorderBrushOutline}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ListBorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey MenuPopupBorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey PopupBorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ToolTipBorderBrush}" Color="#4A4F5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ProgressBarBorderBrush}" Color="#4A4F5A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Teal-green accent (redesign locked decision 12): a custom accent ramp
             generated from the mockup color replaces ActiPro's default blue. -->
        <actipro:ModernTheme>
            <actipro:ModernTheme.Definition>
                <generation:ThemeDefinition AccentColorRampName="VdfAccent">
                    <generation:ThemeDefinition.ColorPaletteFactory>
                        <utils:VdfColorPaletteFactory />
                    </generation:ThemeDefinition.ColorPaletteFactory>
                </generation:ThemeDefinition>
            </actipro:ModernTheme.Definition>
        </actipro:ModernTheme>
        <StyleInclude Source="avares://VDF.GUI/Styles/Styles.xaml" />
    </Application.Styles>
</Application>
