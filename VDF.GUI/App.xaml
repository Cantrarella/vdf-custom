                    <SolidColorBrush x:Key="VdfCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfCardLineBrush" Color="#4A4F5A" />
                    <!-- Same: opaque, where Light and Dark are veils. -->
                    <SolidColorBrush x:Key="VdfRailBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfSunkenBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfAccentSoftBrush" Color="#EAF5FF" />
                    <!-- No shadow: the outline separates the card here. -->
                    <BoxShadows x:Key="VdfCardShadow">0 0 0 0 #00000000</BoxShadows>

                    <SolidColorBrush x:Key="VdfTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="VdfShellBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfCloseHoverBrush" Color="#9E1B1B" />
                    <SolidColorBrush x:Key="VdfOnCloseHoverBrush" Color="#FFFFFF" />
                    <!-- Same two washes (see Light): nothing here either. -->
                    <SolidColorBrush x:Key="VdfGlowTopBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfGlowTopRightBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
