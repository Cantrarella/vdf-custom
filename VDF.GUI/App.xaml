<Application
    x:Class="VDF.GUI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:generation="clr-namespace:ActiproSoftware.UI.Avalonia.Themes.Generation;assembly=ActiproSoftware.Avalonia.Shared"
    xmlns:local="clr-namespace:VDF.GUI"
    xmlns:utils="clr-namespace:VDF.GUI.Utils"
    RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Exact redesign palette (vdf-ux-concept.html tokens). These are the
                     mockup's good/warn/danger/sel roles; the ACCENT itself comes from
                     the VdfAccent ramp below. Border brushes carry the mockup's 45% alpha so
                     badges/chips survive selected-row backgrounds (locked decision 12). -->
                <ResourceDictionary x:Key="Light">
                    <!-- Text tones are darker than the mockup's (#1C8A52 / #A06A10 / #BB4237):
                         those reached only 3.4 to 4.4:1 on white, on their own soft chips and
                         on the checked-row tint. WCAG AA wants 4.5:1. Borders keep the
                         mockup tone, they are not text. -->
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#ECFDF3" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#73BBF7D0" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#FFF7ED" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#73FED7AA" />
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#C9353A" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#FFF2F1" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#73F4CFCD" />
                    <!-- Checked-row tint: the mockup's row-sel blue (#E8F4FF). Checked means
                         "will be deleted", but the state is carried by the tick itself, so the
                         row tint stays in the accent family and follows the theme. Active =
                         the checked row is ALSO list-selected: the opaque checked tint covers
                         the ListBoxItem highlight, so selection needs its own stronger step. -->
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#EAF5FF" />
                    <!-- The mockup's row-sel-hover step (#DCECFD). The selected row is marked
                         by its frame as well. -->
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#DDF0FC" />
                    <!-- The list-selected row: a quiet tint under text that keeps its colors,
                         and a frame. -->
                    <SolidColorBrush x:Key="VdfRowSelectedBrush" Color="#EAF5FF" />
                    <SolidColorBrush x:Key="VdfRowSelectedFrameBrush" Color="#3789CA" />
                    <!-- Text of a selected list item under the pointer. It is one step deeper
                         than the palette's own accent ink (doc Primary Text #2474A6) on
                         purpose: the row under the pointer is not on the palette's selected
                         tint, the theme writes its own hover tint over it, and that tint is a
                         step deeper still - #2474A6 measures 3.6:1 there. See the same
                         reasoning under VdfGoodBrush: the doc's tone is the one to use on the
                         doc's own surface, not on every surface the theme invents. -->
                    <SolidColorBrush x:Key="VdfSelectedHoverTextBrush" Color="#17587F" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#A93B31" />
                    <!-- Secondary text wherever it lands. #60748A is the same grey the mockup
                         dims its captions to, and on white it is fine at 4.9:1, but two of the
                         surfaces it sits on are tinted - the sunken rows (#F1F5F9) and the
                         pointer rows (#EAF5FF) - and there it fell to 4.39 / 4.44:1, under the
                         4.5 a small run of text needs. Two points deeper clears all three
                         (5.01 / 4.58 / 4.54) holding the hue, so nothing about how it reads
                         changes. Derived with scripts rather than picked: see §6.22. -->
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#5E7187" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#D7E0E8" />
                    <!-- The dialog's own edge, and a token of its own rather than VdfMutedBorderBrush:
                         that one is the general hairline and ten other places wear it - the results
                         table's rules, the settings cards, the scan button's ring, the rail's divider - so
                         deepening it for the dialogs would deepen those along with them. Measured against
                         the card the dialogs sit on, the two working themes now read 3.40:1 (#718FA8 on
                         #FFFFFF) and 3.03:1 (#5D6E7D on #19232E), over the 3:1 a graphic boundary is held
                         to. Before this they were 1.34:1 and 1.59:1, a line the eye has to hunt for, and
                         the reference could afford that because its dialogs also carry a large shadow - a
                         shadow a top-level window cannot show (probe-verified). The line is the whole of
                         the boundary here, so the line has to do the whole of the work. -->
                    <SolidColorBrush x:Key="VdfDialogFrameBrush" Color="#718FA8" />
                    <!-- Accent-colored text on a soft accent surface (selected settings section,
                         drive chip, outline accent buttons). The mockup's accent ink. -->
                    <SolidColorBrush x:Key="VdfAccentTextBrush" Color="#2474A6" />
                    <!-- Text on the solid accent (Scan, Next group). -->
                    <SolidColorBrush x:Key="VdfOnAccentBrush" Color="#0F3A55" />
                    <!-- Solid red behind white text (Delete checked): the theme's #EE4343 is 3.8:1. -->
                    <SolidColorBrush x:Key="VdfDangerSolidBrush" Color="#C9353A" />
                    <!-- Settings row under the pointer: the mockup's .row:hover
                         (accent-softer). Rows sit on a white card, so the hover reads
                         against the card, not the page. -->
                    <SolidColorBrush x:Key="VdfRowHoverBrush" Color="#F1F5F9" />
                    <!-- ===== Solid PRIMARY button (mockup .btn-primary) =====
                         The mockup's accent family, one step per state: accent at rest,
                         accent-hover under the pointer, accent-active while pressed. (The
                         variable names drop the mockup's prefix, which an XML comment cannot
                         carry.) It is the pale blue the mockup's own call to action wears, so
                         the ink on it is the mockup's accent-btn-text and not white: #0F3A55
                         on #CDE9FF reads 9.5:1, and 8.5:1 on the hover fill.
                         Deliberately NOT VdfAccentSolidBrush - that key actually holds the
                         Primary TEXT colour, and the sidebar badge and the dialogs' close
                         button share it, so retargeting it would move three things at once.
                         See _Buttons.xaml for why these buttons also need Classes="solid". -->
                    <SolidColorBrush x:Key="VdfPrimarySolidBrush" Color="#CDE9FF" />
                    <SolidColorBrush x:Key="VdfPrimarySolidHoverBrush" Color="#BCDEFC" />
                    <SolidColorBrush x:Key="VdfPrimarySolidPressedBrush" Color="#A8D3F7" />
                    <SolidColorBrush x:Key="VdfOnPrimarySolidBrush" Color="#0F3A55" />
                    <!-- Same as the resting ink, and deliberately so: both pointer grounds
                         are PALE now (see above), so this ink only gains contrast under the
                         pointer and has no reason to deepen. #0F3A55 measures 8.5:1 on the
                         hover fill and 7.8:1 while pressed, against the 4.5:1 a 13.5px label
                         needs. It exists as its own key so one set of pointer rules covers
                         every theme. -->
                    <SolidColorBrush x:Key="VdfOnPrimarySolidPointerBrush" Color="#0F3A55" />
                    <!-- ===== Button pointer states (the mockup's accent family) =====
                         An outlined or soft button answers the pointer by stepping one shade
                         into the accent, not by taking the theme's neutral grey - that grey
                         is what VdfRowHoverBrush holds, and the mockup never puts it behind a
                         button. The ground is split by the button's resting surface:
                         accent-softer behind a transparent ghost, accent-soft behind the soft
                         sunken one, accent-hover behind the solid primary above (see
                         VdfPrimarySolidHoverBrush). The two frames are a ghost's rest
                         (line-2) and its pointer state (accent-line). -->
                    <SolidColorBrush x:Key="VdfBtnHoverBrush" Color="#F3F9FF" />
                    <SolidColorBrush x:Key="VdfBtnSoftHoverBrush" Color="#EAF5FF" />
                    <SolidColorBrush x:Key="VdfBtnHoverLineBrush" Color="#A9D7F6" />
                    <SolidColorBrush x:Key="VdfBtnGhostLineBrush" Color="#D9E1E8" />
                    <!-- The resting fill of a soft button (the mockup's surface-sunken);
                         nothing points at it yet, kept for the next one that does. -->
                    <SolidColorBrush x:Key="VdfBtnSoftSurfaceBrush" Color="#EEF6FD" />
                    <!-- Outline for the destructive buttons (the mockup's danger-line):
                         the ink stays VdfDangerBrush, only the frame lightens, exactly as the
                         mockup splits its danger-ink token from its danger-line token. -->
                    <SolidColorBrush x:Key="VdfDangerLineBrush" Color="#F4CFCD" />
                    <!-- Switch (mockup .switch): off = neutral grey-blue, on = the
                         deep accent, knob white. "Deep" is load-bearing twice over: the two
                         track colours have to differ in lightness or the state cannot be read
                         at a glance, and the near-white knob has to stay visible ON the track
                         it sits in. At #5AA9E6 that pair measured 2.5:1, under the 3:1 an
                         indicator owes whatever it sits on, which walks straight back into the
                         "on looks like off" this pair was written to answer. -->
                    <SolidColorBrush x:Key="VdfSwitchTrackOffBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="VdfSwitchTrackOnBrush" Color="#3789CA" />
                    <SolidColorBrush x:Key="VdfSwitchKnobBrush" Color="#FFFFFF" />
                    <!-- Slider (mockup .slider-track/.slider-fill/.slider-knob): the rest of
                         the track is the sunken surface, the filled part fades from a
                         near-white accent to the accent-active tone, and the knob is a
                         white disc ringed in that same accent-active tone. -->
                    <SolidColorBrush x:Key="VdfSliderTrackBrush" Color="#E3EAF1" />
                    <LinearGradientBrush x:Key="VdfSliderFillBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#5AA9E6" Offset="0" />
                        <GradientStop Color="#7CC0EE" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="VdfSliderKnobBorderBrush" Color="#4799DA" />
                    <!-- Verdict band on the results page (mockup .verdict): the one surface
                         that states what the scan found, so it sits a step above the page in
                         every theme instead of blending into it. The mockup paints it as a
                         120° accent gradient fading into the surface. -->
                    <LinearGradientBrush x:Key="VdfVerdictBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#EAF5FF" Offset="0" />
                        <GradientStop Color="#F4F9FD" Offset="0.78" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="VdfVerdictBorderBrush" Color="#7FBCE5" />
                    <!-- Solid accent (the mockup's accent-deep token): small solid chips — the rail's
                         group badge, the on-state of the filter segment — where the soft
                         fill is too quiet to read as "this is counted in". -->
                    <SolidColorBrush x:Key="VdfAccentSolidBrush" Color="#2474A6" />
                    <!-- Text on the solid accent (the mockup's check-ink token: white). -->
                    <SolidColorBrush x:Key="VdfOnAccentSolidBrush" Color="#FFFFFF" />
                    <!-- The same solid fill under the pointer. It is a step deeper, not a step
                         lighter: a solid accent button has to answer the pointer with a colour
                         of its own. Fading the whole button with an Opacity step instead washed
                         its white label out to 4.25:1 on #2474A6 — under the 4.5:1 a 13px
                         label needs. Deepening the fill keeps the label at full strength
                         (white on this: 5.7:1) and reads as "pressed towards". -->
                    <SolidColorBrush x:Key="VdfAccentFillHoverBrush" Color="#1B6BA0" />
                    <!-- Brand tile (mockup .brand-mark): the accent gradient tile with the
                         white inner ring; the same tile in every theme, like the mockup. -->
                    <LinearGradientBrush x:Key="VdfBrandMarkBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#7FBCE5" Offset="0" />
                        <GradientStop Color="#EAF5FF" Offset="1" />
                    </LinearGradientBrush>
                    <!-- Ink ON the brand tile. The tile keeps the light gradient in every theme
                         (the mockup does the same), so its glyph has to stay the dark accent in
                         every theme too. It used to be VdfAccentTextBrush, which is pale in the
                         dark themes: a pale-blue glyph on a pale-blue tile, invisible. -->
                    <SolidColorBrush x:Key="VdfBrandMarkInkBrush" Color="#17587F" />
                    <!-- The page the cards sit on (the mockup's page-bg token) and the
                         card surface itself (its surface token). They used to be the same
                         white, so a card was readable only by its outline, which read as a
                         frame around the group rather than as a panel. -->
                    <SolidColorBrush x:Key="VdfPageBrush" Color="#F6F9FC" />
                    <SolidColorBrush x:Key="VdfCardBrush" Color="#FFFFFF" />
                    <!-- The hairline along a card's edge: the mockup's own line token (#E4EDF5),
                         which reads as an edge rather than as a frame. (The frame the results
                         page used to show was the list control's own outline: #CCCED3, more
                         than three times this strong.) It is kept light on purpose: the card
                         is separated from the page by the elevation shadow, so this line has
                         only to close the shape. -->
                    <SolidColorBrush x:Key="VdfCardLineBrush" Color="#E2E8F0" />
                    <!-- The rail's own surface (the mockup's rail token): white at 74% over the
                         page bg — left translucent on purpose, which is where its depth comes
                         from. The page carries two wide glows at its top corners (VdfGlow*Brush
                         below); seen through 74% white they leave the rail a touch bluer near
                         those corners than lower down. Flattened to opaque white it would sit
                         next to a #F6F9FC page as a dead white block with nothing in it.
                         The high-contrast themes keep it opaque — see their own entries. -->
                    <SolidColorBrush x:Key="VdfRailBrush" Color="#BDFFFFFF" />
                    <!-- Inset tracks and wells on the rail (the mockup's surface-sunken). -->
                    <SolidColorBrush x:Key="VdfSunkenBrush" Color="#F1F5F9" />
                    <!-- The selected rail entry and the open settings child (the mockup's
                         accent-soft token). Keeping it on the palette stops these two from
                         borrowing the theme's own accent container, which is a step darker. -->
                    <SolidColorBrush x:Key="VdfAccentSoftBrush" Color="#EAF5FF" />
                    <!-- Dimmed secondary text. Dark keeps the mockup's 0.55 / 0.6 / 0.65, which
                         read 5:1 and better as light-on-dark. The same values as dark-on-white
                         are 3.3 to 4.4:1, so the light theme dims less. -->
                    <x:Double x:Key="VdfTextFaintOpacity">0.72</x:Double>
                    <x:Double x:Key="VdfTextMutedOpacity">0.72</x:Double>
                    <x:Double x:Key="VdfTextSoftOpacity">0.72</x:Double>
                    <x:Double x:Key="VdfTextSecondaryOpacity">0.9</x:Double>
                    <!-- Dimmed text by its value. The same in light and dark, so nothing changes
                         there; what matters is that the high contrast themes set all of them
                         to 1: dimming is contrast taken away on purpose. -->
                    <x:Double x:Key="VdfTextDim90Opacity">0.9</x:Double>
                    <x:Double x:Key="VdfTextDim85Opacity">0.85</x:Double>
                    <x:Double x:Key="VdfTextDim80Opacity">0.8</x:Double>
                    <x:Double x:Key="VdfTextDim75Opacity">0.75</x:Double>
                    <x:Double x:Key="VdfTextDim70Opacity">0.7</x:Double>
                    <x:Double x:Key="VdfTextDim55Opacity">0.55</x:Double>
                    <!-- Placeholder text in an empty field: the theme's own look. -->
                    <x:Double x:Key="VdfPlaceholderOpacity">0.67</x:Double>
                    <!-- A card sits on the page and lifts off it (the mockup's Elevation):
                         a tight contact shadow under the edge, then a wide soft one for
                         depth. Two parts, because one alone reads as a blur. -->
                    <BoxShadows x:Key="VdfCardShadow">0 2 8 0 #0D0F2337, 0 14 32 -18 #2E0F2337</BoxShadows>

                    <!-- Main text ink (doc 主文字). It was whatever the theme defaults to;
                         the Window style hangs it on every window, and TextBlock inherits. -->
                    <SolidColorBrush x:Key="VdfTextBrush" Color="#172033" />
                    <!-- The band the window paints above its content (doc 顶部标题栏). The rail
                         is its own surface, so the shell and the rail are two tokens: white rail,
                         page-toned shell. -->
                    <SolidColorBrush x:Key="VdfShellBrush" Color="#F6F9FC" />
                    <!-- The dialog close button under the pointer (doc Danger Text): white on
                         the doc's Danger #E5484D is 3.9:1, which the contrast suite rejects for
                         a 13px glyph, and Danger Text is the same red two steps down. -->
                    <SolidColorBrush x:Key="VdfCloseHoverBrush" Color="#C9353A" />
                    <SolidColorBrush x:Key="VdfOnCloseHoverBrush" Color="#FFFFFF" />
                    <!-- Scroll bar (doc 滚动条): transparent track, one thumb tone, no blue.
                         ActiPro draws the bar from these keys, so they are set per theme. -->
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushVertical}" Color="#C7D1DC" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushHorizontal}" Color="#C7D1DC" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushVerticalPointerOver}" Color="#AEBCCA" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushHorizontalPointerOver}" Color="#AEBCCA" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushVerticalPressed}" Color="#AEBCCA" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushHorizontalPressed}" Color="#AEBCCA" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarBackgroundBrushVertical}" Color="Transparent" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarBackgroundBrushHorizontal}" Color="Transparent" />
                    <!-- Two wide washes at the top corners of the window (the mockup's body
                         background). They are what gives the rail something to be translucent
                         OVER: seen through 74% white they cool it towards those corners, so the
                         rail is not one flat tone top to bottom. Nothing sits between them and
                         the window's own surface, so there is no detail for a real backdrop
                         blur to find - the veiling alone is the effect.

                         Colour only: the SHAPE comes from MainWindow, which paints each one
                         into an ellipse and blurs it (see there for why it is not a gradient
                         brush). Each value is the mockup's accent already mixed into the page
                         tone - 16% / 10% here, 10% / 6% in dark, nothing at all in high
                         contrast, where veiling would only spend contrast. -->
                    <SolidColorBrush x:Key="VdfGlowTopBrush" Color="#DDECF8" />
                    <SolidColorBrush x:Key="VdfGlowTopRightBrush" Color="#E6F1FA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#45B878" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#17301F" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#7345B878" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#D29A3A" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#33260E" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#73D29A3A" />
                    <!-- lighter than the mockup's #E06A5E, which is 4.3:1 on the checked-row tint -->
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#EB8378" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#391914" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#73E06A5E" />
                    <!-- Same split of ink and line as light, in this theme's own danger family
                         (see Light for why the frame is not the same colour as the text). -->
                    <SolidColorBrush x:Key="VdfDangerLineBrush" Color="#5C3134" />
                    <!-- Checked-row tint: the mockup's row-sel over the dark surface
                         (rgba(205,233,255,.12) on #16212E). The state is carried by the
                         tick itself, so the row tint stays in the accent family. Active =
                         the checked row is ALSO list-selected: the opaque checked tint
                         covers the ListBoxItem highlight, so selection needs its own
                         stronger step. -->
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#213344" />
                    <!-- The mockup's row-sel-hover step (rgba(205,233,255,.18)). The selected
                         row is marked by its frame as well. -->
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#263E53" />
                    <!-- The list-selected row: a quiet tint under text that keeps its colors,
                         and a frame. -->
                    <SolidColorBrush x:Key="VdfRowSelectedBrush" Color="#213344" />
                    <SolidColorBrush x:Key="VdfRowSelectedFrameBrush" Color="#8DCCF2" />
                    <!-- Text of a selected list item under the pointer. Here the reasoning
                         under the light copy of this token inverts, and carrying its wording
                         over is what broke this one: the light accent tint is pale, so the
                         text there goes dark, but THIS theme's selected tint is #213344, already
                         deep, and dark ink on it measured 1.30:1 on a dialog list. Dark carries
                         light text of its own for exactly that reason, same as upstream had it. -->
                    <SolidColorBrush x:Key="VdfSelectedHoverTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#C05248" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#9AAABD" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#1E2935" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#354454" />
                    <!-- The dialog's own edge, and a token of its own rather than VdfMutedBorderBrush:
                         that one is the general hairline and ten other places wear it - the results
                         table's rules, the settings cards, the scan button's ring, the rail's divider - so
                         deepening it for the dialogs would deepen those along with them. Measured against
                         the card the dialogs sit on, the two working themes now read 3.40:1 (#718FA8 on
                         #FFFFFF) and 3.03:1 (#5D6E7D on #19232E), over the 3:1 a graphic boundary is held
                         to. Before this they were 1.34:1 and 1.59:1, a line the eye has to hunt for, and
                         the reference could afford that because its dialogs also carry a large shadow - a
                         shadow a top-level window cannot show (probe-verified). The line is the whole of
                         the boundary here, so the line has to do the whole of the work. -->
                    <SolidColorBrush x:Key="VdfDialogFrameBrush" Color="#5D6E7D" />
                    <SolidColorBrush x:Key="VdfAccentTextBrush" Color="#8DCCF2" />
                    <!-- The accent is pale, so the text on it goes dark. -->
                    <SolidColorBrush x:Key="VdfOnAccentBrush" Color="#0B1F2E" />
                    <SolidColorBrush x:Key="VdfDangerSolidBrush" Color="#D32F2F" />
                    <!-- Settings row under the pointer: the mockup's accent-softer over
                         the dark card. -->
                    <SolidColorBrush x:Key="VdfRowHoverBrush" Color="#1E2935" />
                    <!-- Solid primary button (see Light). The mockup keeps the same pale fill
                         in the dark theme and lists its two steps in that block's own row of
                         the palette: accent-hover (#E0F3FF) is a step UP from the resting
                         fill, accent-active (#B6DCF7) a step down. -->
                    <SolidColorBrush x:Key="VdfPrimarySolidBrush" Color="#CDE9FF" />
                    <SolidColorBrush x:Key="VdfPrimarySolidHoverBrush" Color="#E0F3FF" />
                    <SolidColorBrush x:Key="VdfPrimarySolidPressedBrush" Color="#B6DCF7" />
                    <SolidColorBrush x:Key="VdfOnPrimarySolidBrush" Color="#0B1F2E" />
                    <!-- No deeper ink needed here either: #0B1F2E on the hover fill reads
                         14.7:1 and even the pressed step stays at 11.9:1. Kept as its own
                         key so one set of pointer rules can cover every theme. -->
                    <SolidColorBrush x:Key="VdfOnPrimarySolidPointerBrush" Color="#0B1F2E" />
                    <!-- Button pointer states (see Light). The accent is the same pale blue
                         in this theme, so the three grounds are that colour at the opacities
                         the mockup's dark block gives (.07 / .13 / .34 over the page),
                         flattened to #AARRGGBB the way the rest of this block does. -->
                    <SolidColorBrush x:Key="VdfBtnHoverBrush" Color="#12CDE9FF" />
                    <SolidColorBrush x:Key="VdfBtnSoftHoverBrush" Color="#21CDE9FF" />
                    <SolidColorBrush x:Key="VdfBtnHoverLineBrush" Color="#57CDE9FF" />
                    <SolidColorBrush x:Key="VdfBtnGhostLineBrush" Color="#33CDE9FF" />
                    <!-- The resting fill of a soft button; nothing points at it yet (see Light). -->
                    <SolidColorBrush x:Key="VdfBtnSoftSurfaceBrush" Color="#101A25" />
                    <!-- Switch (mockup .switch): off = neutral grey-blue, on = the
                         deep accent, knob white. "Deep" is load-bearing twice over: the two
                         track colours have to differ in lightness or the state cannot be read
                         at a glance, and the near-white knob has to stay visible ON the track
                         it sits in. At #5AA9E6 that pair measured 2.5:1, under the 3:1 an
                         indicator owes whatever it sits on, which walks straight back into the
                         "on looks like off" this pair was written to answer. -->
                    <SolidColorBrush x:Key="VdfSwitchTrackOffBrush" Color="#45566A" />
                    <SolidColorBrush x:Key="VdfSwitchTrackOnBrush" Color="#3789CA" />
                    <SolidColorBrush x:Key="VdfSwitchKnobBrush" Color="#E9F4FF" />
                    <!-- Slider: same roles as the light theme, on the dark sunken tone. -->
                    <SolidColorBrush x:Key="VdfSliderTrackBrush" Color="#2A3745" />
                    <LinearGradientBrush x:Key="VdfSliderFillBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#5AA9E6" Offset="0" />
                        <GradientStop Color="#72B9EE" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="VdfSliderKnobBorderBrush" Color="#4799DA" />
                    <!-- Verdict band: the dark counterpart keeps the accent-tinged fade,
                         but from a deep accent-navy so the light verdict text stays clear
                         across the whole band. -->
                    <LinearGradientBrush x:Key="VdfVerdictBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#213B54" Offset="0" />
                        <GradientStop Color="#17212C" Offset="0.78" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="VdfVerdictBorderBrush" Color="#2E5A7D" />
                    <!-- Solid accent chips: in the dark theme the mockup's accent-deep is
                         the pale accent itself, with dark ink on it. -->
                    <SolidColorBrush x:Key="VdfAccentSolidBrush" Color="#8DCCF2" />
                    <SolidColorBrush x:Key="VdfOnAccentSolidBrush" Color="#0B1F2E" />
                    <!-- Hover step for that fill: here the fill is the pale one and the ink the
                         dark one, so the step goes the other way - lighter (doc Primary Text 2),
                         which only makes the dark ink clearer. -->
                    <SolidColorBrush x:Key="VdfAccentFillHoverBrush" Color="#A5D8F5" />
                    <!-- Brand tile: the mockup keeps the same light gradient tile on the
                         dark rail, so the brand stays the brand when the theme flips. -->
                    <LinearGradientBrush x:Key="VdfBrandMarkBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#7FBCE5" Offset="0" />
                        <GradientStop Color="#EAF5FF" Offset="1" />
                    </LinearGradientBrush>
                    <!-- Ink ON the brand tile. The tile keeps the light gradient in every theme
                         (the mockup does the same), so its glyph has to stay the dark accent in
                         every theme too. It used to be VdfAccentTextBrush, which is pale in the
                         dark themes: a pale-blue glyph on a pale-blue tile, invisible. -->
                    <SolidColorBrush x:Key="VdfBrandMarkInkBrush" Color="#17587F" />
                    <SolidColorBrush x:Key="VdfPageBrush" Color="#111820" />
                    <SolidColorBrush x:Key="VdfCardBrush" Color="#19232E" />
                    <SolidColorBrush x:Key="VdfCardLineBrush" Color="#2A3745" />
                    <!-- The mockup's rgba(19,30,42,.78) — same reason as light: the rail is a
                         veil over the glows, not a slab. -->
                    <SolidColorBrush x:Key="VdfRailBrush" Color="#C7131E2A" />
                    <SolidColorBrush x:Key="VdfSunkenBrush" Color="#151F29" />
                    <SolidColorBrush x:Key="VdfAccentSoftBrush" Color="#223748" />
                    <x:Double x:Key="VdfTextFaintOpacity">0.55</x:Double>
                    <x:Double x:Key="VdfTextMutedOpacity">0.6</x:Double>
                    <x:Double x:Key="VdfTextSoftOpacity">0.65</x:Double>
                    <x:Double x:Key="VdfTextSecondaryOpacity">0.7</x:Double>
                    <!-- Dimmed text by its value. The same in light and dark, so nothing changes
                         there; what matters is that the high contrast themes set all of them
                         to 1: dimming is contrast taken away on purpose. -->
                    <x:Double x:Key="VdfTextDim90Opacity">0.9</x:Double>
                    <x:Double x:Key="VdfTextDim85Opacity">0.85</x:Double>
                    <x:Double x:Key="VdfTextDim80Opacity">0.8</x:Double>
                    <x:Double x:Key="VdfTextDim75Opacity">0.75</x:Double>
                    <x:Double x:Key="VdfTextDim70Opacity">0.7</x:Double>
                    <x:Double x:Key="VdfTextDim55Opacity">0.55</x:Double>
                    <!-- Placeholder text in an empty field: the theme's own look. -->
                    <x:Double x:Key="VdfPlaceholderOpacity">0.67</x:Double>
                    <!-- Dark surfaces swallow a soft shadow, so the dark theme lifts the
                         card with more opacity and a longer falloff instead. -->
                    <BoxShadows x:Key="VdfCardShadow">0 2 8 0 #52000000, 0 18 40 -20 #8C000000</BoxShadows>

                    <SolidColorBrush x:Key="VdfTextBrush" Color="#E8F0F7" />
                    <SolidColorBrush x:Key="VdfShellBrush" Color="#141D27" />
                    <SolidColorBrush x:Key="VdfCloseHoverBrush" Color="#C9353A" />
                    <SolidColorBrush x:Key="VdfOnCloseHoverBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushVertical}" Color="#3A4A5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushHorizontal}" Color="#3A4A5A" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushVerticalPointerOver}" Color="#4B5D70" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushHorizontalPointerOver}" Color="#4B5D70" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushVerticalPressed}" Color="#4B5D70" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarThumbBackgroundBrushHorizontalPressed}" Color="#4B5D70" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarBackgroundBrushVertical}" Color="Transparent" />
                    <SolidColorBrush x:Key="{actipro:ThemeResourceKey ScrollBarBackgroundBrushHorizontal}" Color="Transparent" />
                    <!-- Two wide radial glows at the top corners of the window (the mockup's
                         body background). They are what gives the rail something to be
                         translucent OVER: seen through 74% white they cool it towards those
                         corners, so the rail is not one flat tone top to bottom. Nothing sits
                         between them and the window's own surface, so there is no detail for a
                         real backdrop blur to find - the veiling alone is the effect. -->
                    <SolidColorBrush x:Key="VdfGlowTopBrush" Color="#242D36" />
                    <SolidColorBrush x:Key="VdfGlowTopRightBrush" Color="#1C252D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Blue accent (redesign locked decision 12): a custom accent ramp generated
             from the mockup color replaces ActiPro's default. -->
        <actipro:ModernTheme>
            <actipro:ModernTheme.Definition>
                <generation:ThemeDefinition AccentColorRampName="VdfAccent">
                    <generation:ThemeDefinition.ColorPaletteFactory>
                        <utils:VdfColorPaletteFactory />
                    </generation:ThemeDefinition.ColorPaletteFactory>
                </generation:ThemeDefinition>
            </actipro:ModernTheme.Definition>
        </actipro:ModernTheme>
        <StyleInclude Source="avares://VDF.GUI/Styles/Styles.xaml" />
    </Application.Styles>
</Application>
