<Window
    x:Class="VDF.GUI.Views.MessageBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="using:VDF.GUI.ViewModels"
    x:DataType="vm:MessageBoxVM"
    Title="{Binding Title}"
    MinWidth="400"
    MaxWidth="600"
    MaxHeight="600"
    CanResize="false"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowDecorations="BorderOnly">
    <ScrollViewer x:Name="ScrollViewerMessageboxContent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- This box is the program's voice for every confirmation and every error. It now
             carries no caption at all and no card of its own: the window is the card
             (Window rule, Styles/_Dialogs.xaml), so the box is the message and its buttons
             and nothing else. -->
        <Border Classes="dlgbody">
            <Grid RowDefinitions="Auto, Auto" RowSpacing="20">
                <!-- MaxWidth must be set here, not only on the window: SizeToContent measures
                     the text at infinite width first, so the window's own MaxWidth clamp CLIPS
                     an unbroken line (e.g. a long path) instead of wrapping it. -->
                <TextBlock
                    Grid.Row="0"
                    Classes="dlgtext"
                    MaxWidth="520"
                    Margin="0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="1" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <!-- The affirmative answer carries the accent, the rest stay ghost:
                         the dialog names a decision, it should not offer two equal ones. -->
                    <Button
                        x:Name="OkButton"
                        Grid.Column="1"
                        Classes="dlgprimary"
                        Margin="5,0"
                        Command="{Binding OKCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.OK]}"
                        IsVisible="{Binding HasOKButton}" />
                    <Button
                        x:Name="YesButton"
                        Grid.Column="2"
                        Classes="dlgprimary"
                        Margin="5,0"
                        Command="{Binding YesCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Yes]}"
                        IsVisible="{Binding HasYesButton}" />
                    <Button
                        x:Name="NoButton"
                        Grid.Column="3"
                        Classes="dlgghost"
                        Margin="5,0"
                        Command="{Binding NoCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.No]}"
                        IsVisible="{Binding HasNoButton}" />
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="4"
                        Classes="dlgghost"
                        Margin="5,0"
                        Command="{Binding CancelCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Cancel]}"
                        IsVisible="{Binding HasCancelButton}" />
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
