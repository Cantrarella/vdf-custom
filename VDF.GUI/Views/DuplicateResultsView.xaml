<UserControl
    x:Class="VDF.GUI.Views.DuplicateResultsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Settings="clr-namespace:VDF.GUI.Data;assembly=VDF.GUI"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:ctl="clr-namespace:VDF.GUI.Controls;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels;assembly=VDF.GUI"
    x:DataType="vm:MainWindowVM"
    x:Name="ResultsRoot">

  <UserControl.Resources>
    <!-- Own instances of the shared cell converters: StaticResource inside this
         control's templates resolves against THIS scope, not the host window's. -->
    <mvvm:SimilarityTierConverter x:Key="SimilarityTierConverter" />
    <mvvm:EqualDiffConverter x:Key="EqualDiffConverter" />
    <mvvm:BitrateDisplayConverter x:Key="BitrateDisplayConverter" />
    <mvvm:SimilarityToFormattedConverter x:Key="SimilarityToFormattedConverter" />
    <mvvm:MetricDisplayConverter x:Key="MetricDisplayConverter" />
    <mvvm:ShowSkeletonConverter x:Key="ShowSkeletonConverter" />
    <mvvm:ExtraShortDateTimeConverter x:Key="ExtraShortDateTimeConverter" />
    <mvvm:FileNameConverter x:Key="FileNameConverter" />
    <mvvm:DirectoryPathConverter x:Key="DirectoryPathConverter" />
    <mvvm:ResultsRowSizingConverter x:Key="ResultsRowSizingConverter" />
    <mvvm:BoolToValueConverter x:Key="SortDirectionGlyphConverter" TrueValue="↓" FalseValue="↑" />
    <!-- The group caret, from the icon the user supplied (a 1024x1024 viewBox). Expanded it
         points down; collapsed it is the same triangle given a quarter turn to the right, so
         the second path is the first one rotated about (512,512) — no transform at render
         time, and both states keep the same ink weight. -->
    <StreamGeometry x:Key="ChevronDownGeometry">M938.731988 88.590688c12.600993-6.859221 26.437116 6.808056 19.732413 19.492959L523.883655 930.264129c-5.437849 10.289344-20.175505 10.289344-25.614378 0L63.688531 108.083647c-6.704702-12.68388 7.131421-26.352181 19.732414-19.492959l427.65501 232.794997L938.731988 88.590688z</StreamGeometry>
    <StreamGeometry x:Key="ChevronRightGeometry">M88.5907 85.268c-6.85922-12.601 6.80806-26.4371 19.493-19.7324L930.264 500.116c10.2893 5.43785 10.2893 20.1755 0 25.6144L108.084 960.311c-12.6839 6.7047-26.3522-7.13142-19.493-19.7324l232.795-427.655L88.5907 85.268z</StreamGeometry>
    <!-- #854: compact rows keep the single-line name; comfortable rows may wrap to two. -->
    <mvvm:BoolToValueConverter x:Key="FileNameMaxLinesConverter" TrueValue="1" FalseValue="2" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Compact summary leaves the available height to the virtualized file list. -->
    <Style Selector="Border.verdictcard">
      <Setter Property="Padding" Value="18,12" />
    </Style>
    <Style Selector="Button.group-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The chevron shows a glyph only; its accessible name says what pressing it does.
         It drops the theme's button outline: every Button in this theme is drawn with a
         1px frame, which around a bare 12px triangle reads as a box drawn round the arrow
         rather than as a control - the triangle is the whole control. The pointerover
         well goes with it, so hovering answers by deepening the triangle itself instead
         of painting a square behind it. -->
    <Style Selector="Button.chevron">
      <Setter Property="AutomationProperties.Name" Value="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Results.CollapseGroup]}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.chevron.collapsed">
      <Setter Property="AutomationProperties.Name" Value="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Results.ExpandGroup]}" />
    </Style>
    <!-- The caret itself: the solid triangle the user supplied, drawn at the size of the
         similarity chips it faces across the group header (12px box, ~11px of ink), where the
         text glyph it replaces (▾ / ▸) sat at the mercy of the font's own metrics. -->
    <Style Selector="Path.chevglyph">
      <Setter Property="Fill" Value="{DynamicResource VdfAccentTextBrush}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.group-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
      <!-- On the presenter, like every other frame in this batch: the theme's pointerover
           rule paints its grey straight onto this part, so a setter on the button itself
           never reaches the frame. This one had no pointer frame rule at all, which is
           why hovering it swapped #B7BAC1 for the theme's darker #9FA3AD. -->
      <Setter Property="BorderBrush" Value="{DynamicResource VdfBtnHoverLineBrush}" />
    </Style>
    <!-- ... except the chevron, which has no frame to fill: see Button.chevron above. -->
    <Style Selector="Button.chevron:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chevron:pointerover Path.chevglyph">
      <Setter Property="Fill" Value="{DynamicResource VdfSelectedHoverTextBrush}" />
    </Style>
    <!-- Row action pair (mockup .btn-ghost.btn-sm): outlined and quiet, because two of
         them now sit in every row. They brighten on hover instead of shouting. -->
    <Style Selector="Button.fileact">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfMutedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <!-- mockup .btn-ghost.btn-sm: 6px 11px and 12.5px. The row's own buttons were
           9x2 at 12px, a size the mockup does not use anywhere. -->
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.fileact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfBtnHoverLineBrush}" />
    </Style>
    <Style Selector="Button.fileact:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VdfTextBrush}" />
    </Style>
    <!-- AI-matched group strip (mockup .callout). Amber, not the mockup's red: in this
         build red means "this will be deleted", and this strip is the opposite advice. -->
    <!-- mockup .callout: 12px in from the card's sides, 10px under it, 13px 11px inside,
         and the r-sm radius. It hangs straight off the group head, so its own top margin
         is 0 — the head's bottom edge is the only gap it needs. -->
    <Style Selector="Border.callout">
      <Setter Property="Margin" Value="12,0,12,10" />
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource VdfWarnSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfWarnBorderBrush}" />
    </Style>
    <!-- The list draws no frame of its own: the group cards are the only panels on this
         page. The theme's ListBox brings a hard 1px outline (#B7BAC1 in the light theme),
         and it landed one pixel outside every card's own hairline - so each card read as
         double-framed, and the outline was stronger than anything the mockup has. -->
    <Style Selector="ListBox.results">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The list's scrollbar used to be dimmed to 0.4 here because the theme's own thumb
         was a full-strength grey (#9FA3AD) and read as a stripe down the page edge. The
         colour scheme now names the thumb (#C7D1DC, hover #AEBCCA in light; #3A4A5A, hover
         #4B5D70 in dark) and App.xaml sets it on the ActiPro keys the bar is drawn from, so
         the dimming would only wash those out. The bare selector stays - the bar lives two
         templates deep in the ListBox and neither a /template/ nor a descendant selector
         reached it - now only to keep the hover step visible. -->
    <Style Selector="ScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <!-- The rows paint their own surfaces (Border.cardtop / .cardseg / .grouprow), so the
           item must not paint one of its own. The theme fills the item with a neutral grey
           under the pointer, and on the group header that grey showed up in the 14px gap
           above the card - a band the user read as a shadow under the card. -->
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.colheader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="{DynamicResource VdfTextSoftOpacity}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <!-- Column widths are fixed (#853) but header text is localized: a translation
           that outgrows its column must degrade to an ellipsis, not clip glyphs. -->
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="{DynamicResource VdfTextDim85Opacity}" />
    </Style>
    <Style Selector="ToggleButton.chip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Checked rows: red tint (checked = marked for deletion) plus a danger-colored
         left edge bar, so they stay clearly visible in dark mode where a background
         tint alone drowned against the near-black rows (#841). The 3px edge slot is
         always reserved (transparent when unchecked) so content never shifts. -->
    <Style Selector="Border.resultrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.resultrow.checked">
      <Setter Property="Background" Value="{DynamicResource VdfSelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfDangerBrush}" />
    </Style>
    <!-- Checked row that is ALSO list-selected: the opaque checked tint sits on top
         of the ListBoxItem's own selection highlight, which left selection nearly
         invisible (only the foreground shifted). A clearly brighter tint step makes
         the selected row stand out inside a block of checked rows. -->
    <Style Selector="ListBox.results ListBoxItem:selected Border.resultrow.checked">
      <Setter Property="Background" Value="{DynamicResource VdfSelActiveBrush}" />
    </Style>
    <!-- The list-selected row. The theme fills it with a saturated accent and switches its
         text to an accent tone; on that, the red and green metric values came out at
         2.2:1 in dark and the dimmed secondary text at 3.4:1 in light, on the very row a
         keyboard user is working on. A tint strong enough to be seen cannot stay under
         4.5:1 for all of that text, so the tint is quiet, the text keeps its colors, and
         selection is shown by a frame: a shape, which also works without telling teal
         from red. The frame is a border of its own laid over the row, so that no row
         changes size (a box shadow is not drawn on a Border with uneven thickness, which
         the rows have for their edge bar). -->
    <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfRowSelectedBrush}" />
      <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}" />
    </Style>
    <!-- While the mouse button is down the theme paints a grey of its own (metric values
         at 4.2:1): the row takes the tint it is about to get anyway. -->
    <Style Selector="ListBox.results ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfRowSelectedBrush}" />
    </Style>
    <Style Selector="Border.selframe">
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:selected Border.selframe">
      <Setter Property="BorderBrush" Value="{DynamicResource VdfRowSelectedFrameBrush}" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:selected Border.detailsrow">
      <Setter Property="BorderBrush" Value="{DynamicResource VdfRowSelectedFrameBrush}" />
    </Style>
    <!-- similarity chip: mockup .simchip — soft surface, colored text, 45%-alpha
         border; tier classes (mid/low) are bound from the similarity value -->
    <Style Selector="Border.simchip">
      <Setter Property="Background" Value="{DynamicResource VdfGoodSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfGoodBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <!-- A horizontal StackPanel stretches its children across the cross axis, so a chip
           that shares a row with a button is pulled up to the button's 31px while its
           text still lays out one 11.5 line box, top aligned: 6px above, 16px below. The
           file row's own chip never showed this because it sets this itself; setting it
           here covers every chip instead of the one that happened to be noticed. -->
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.simchip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VdfGoodBrush}" />
    </Style>
    <Style Selector="Border.simchip.mid">
      <Setter Property="Background" Value="{DynamicResource VdfWarnSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfWarnBorderBrush}" />
    </Style>
    <Style Selector="Border.simchip.mid TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VdfWarnBrush}" />
    </Style>
    <Style Selector="Border.simchip.low">
      <Setter Property="Background" Value="{DynamicResource VdfDangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfDangerBorderBrush}" />
    </Style>
    <Style Selector="Border.simchip.low TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VdfDangerBrush}" />
    </Style>
    <!-- metric best/worst emphasis: mockup .hi/.lo (good/danger, weight 600).
         .eq mutes both while the hover-diff shows equal values — declared last
         so it wins the Foreground when combined with hi/lo. -->
    <Style Selector="TextBlock.metric-diff.hi">
      <Setter Property="Foreground" Value="{DynamicResource VdfGoodBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Only the best value is set in semibold. Both used to be, which left red against
         green as the ONLY difference between a group's best and its other values, the
         pair that color-blind users cannot tell apart. -->
    <Style Selector="TextBlock.metric-diff.lo">
      <Setter Property="Foreground" Value="{DynamicResource VdfDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-diff.eq">
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
    </Style>
    <!-- Hover-diff swap fades in instead of snapping (#849 report: values flipping
         "suddenly forth and back"). Only activation animates; clearing restores the
         familiar values immediately. -->
    <Style Selector="Window:not(.reduce-motion) TextBlock.metric-diff.diffing">
      <Style.Animations>
        <Animation Duration="0:0:0.18" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- HDR chip: neutral bordered info chip; green when it wins a mixed group -->
    <Style Selector="Border.hdrchip">
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.hdrchip TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Opacity" Value="{DynamicResource VdfTextDim75Opacity}" />
    </Style>
    <Style Selector="Border.hdrchip.best">
      <Setter Property="Background" Value="{DynamicResource VdfGoodSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfGoodBorderBrush}" />
    </Style>
    <Style Selector="Border.hdrchip.best TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VdfGoodBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===== Mockup tokens: results page. Names follow the prototype's classes so a
         look at the two side by side still answers "which one is this". ===== -->
    <!-- mockup .verdict: the one statement the page makes before any detail. Rounded
         card, not the old full-bleed band: the prototype floats it over the page. -->
    <Style Selector="Border.verdictcard">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="20,15" />
      <Setter Property="Background" Value="{DynamicResource VdfVerdictBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfVerdictBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- mockup .search: icon inside the field, no caption above it -->
    <Style Selector="Border.searchbox">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="8,0,13,0" />
      <Setter Property="Background" Value="{DynamicResource VdfCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.searchbox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource VdfVerdictBorderBrush}" />
    </Style>
    <!-- mockup .filters: sunken track with the active facet lifted onto a card -->
    <Style Selector="Border.filtertrack">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="{DynamicResource VdfSunkenBrush}" />
    </Style>
    <Style Selector="Button.filteritem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.filteritem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
    </Style>
    <Style Selector="Button.filteritem.on">
      <Setter Property="Background" Value="{DynamicResource VdfRowSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VdfAccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.filteritem.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfRowSelectedBrush}" />
    </Style>
    <!-- The count beside each facet label. It carries no Opacity: 11px text cannot afford
         any. Dimmed to 0.65 this grey landed at 2.40:1 on the counters row, and no amount of
         dimming reaches 4.5 once the run is this small (see VdfMutedBrush in App.xaml - even
         at full strength these greys only just clear it). The step down from the label's own
         colour to VdfMutedBrush is the whole of the hierarchy here, and that is enough: it is
         the same move Border.hdrchip.best already makes when a value has to be read. -->
    <Style Selector="TextBlock.facetn">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- mockup .btn-ghost.btn-sm, reused by the toolbar's right hand side:
         outlined and quiet, brightening on hover instead of shouting -->
    <Style Selector="Button.ghostsm">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
    </Style>
    <Style Selector="Button.ghostsm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfBtnHoverLineBrush}" />
    </Style>
    <Style Selector="Button.ghostsm:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VdfTextBrush}" />
    </Style>
    <!-- mockup .group-idx: the group number, sitting where the old chevron was -->
    <Style Selector="Border.idxbadge">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource VdfRowSelectedBrush}" />
    </Style>
    <Style Selector="Border.idxbadge TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource VdfAccentTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- mockup .card.group: the flattened list has no card container of its own, so the
         card is drawn by consecutive list rows: the header, every member, the AI strip
         and the details panel. Each wears the card's own surface; a transparent body over
         a same-coloured page was what made a group read as a stray outline instead of a
         panel. The card's panel look therefore comes from its own surface and hairline on
         the page background, and not from the mockup's card shadow: a row lives inside a
         virtualising list, which composites each item into its own bounds, so anything a
         row casts outside itself is cut off. Measured, not assumed.
         A closing row CAN be made to cast (uniform 1px border + 14px of its own bottom
         margin as the landing strip — both were tried on 2026-09-28), but the user read
         the result as a shadow under one item inside the card and asked for it off: a
         card whose middle rows are flat and whose last row lifts does not read as one
         panel either. Re-adding a shadow here is wasted work. -->
    <Style Selector="Border.cardseg">
      <Setter Property="Background" Value="{DynamicResource VdfCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1,0,1,0" />
    </Style>
    <!-- The header: the card's top edge and its rounded shoulders -->
    <Style Selector="Border.cardtop">
      <Setter Property="Background" Value="{DynamicResource VdfCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20,20,0,0" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <!-- Whoever ends the group closes the card, and a collapsed group is nothing but its
         header, which the builder flags the same way -->
    <Style Selector="Border.cardseg.rowend">
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,20,20" />
    </Style>
    <Style Selector="Border.cardtop.rowend">
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <!-- mockup .file.marked: checked means marked for deletion. The prototype tints
         those rows blue and keeps red for the "will be deleted" label. -->
    <Style Selector="Border.grouprow.checked">
      <Setter Property="Background" Value="{DynamicResource VdfSelBrush}" />
    </Style>
    <Style Selector="Border.grouprow">
      <Setter Property="BorderThickness" Value="1,0,1,1" />
    </Style>
    <!-- mockup .file:hover / .file.marked:hover -->
    <Style Selector="Border.grouprow:pointerover">
      <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
    </Style>
    <Style Selector="Border.grouprow.checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource VdfSelActiveBrush}" />
    </Style>
    <!-- mockup .file-specs separator: each value block carries its own dot, so hiding a
         column hides its dot too instead of leaving a row of lone dots behind -->
    <Style Selector="TextBlock.specsep">
      <Setter Property="Text" Value="·" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.42" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- mockup .ai-tag: dashed fixtures need no solid frame of their own -->
    <Style Selector="Border.aitag">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="Background" Value="{DynamicResource VdfSunkenBrush}" />
      <!-- Same row, same stretch, same reason as Border.simchip above. -->
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.aitag TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
    </Style>
    <!-- mockup .keep-tag: the member the ranker would keep -->
    <Style Selector="Border.keeptag">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Background" Value="{DynamicResource VdfRowSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfVerdictBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.keeptag TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource VdfAccentTextBrush}" />
    </Style>
    <!-- The advanced strip: VDF's own filters, kept out of the way rather than dropped -->
    <Style Selector="Border.advstrip">
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource VdfSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- mockup .wrap: 32px gutters, 1080px measure -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="32,2,32,0">

    <!-- ======== Verdict band (mockup .verdict): what the scan found, stated once at
         the top before any list detail. The three numbers decide whether this run is
         worth acting on at all, so they carry the page's largest type. ======== -->
    <Border Grid.Row="0" Classes="verdictcard" Margin="0,0,0,0">
      <DockPanel LastChildFill="True">
        <!-- "N groups need a look": amber, the same "read this before you delete"
             colour the AI strip uses. Red stays reserved for the delete action itself. -->
        <Border
            DockPanel.Dock="Right"
            IsVisible="{Binding !!GroupsNeedingReview}"
            VerticalAlignment="Center"
            Margin="14,0,0,0"
            Padding="9,3"
            CornerRadius="99"
            Background="{DynamicResource VdfWarnSoftBrush}"
            BorderBrush="{DynamicResource VdfWarnBorderBrush}"
            BorderThickness="1">
          <TextBlock FontSize="11.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource VdfWarnBrush}">
            <Run Text="{Binding GroupsNeedingReview, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Verdict.NeedReview]}" />
          </TextBlock>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <!-- mockup .verdict-nums: three facts at 21px, everything else stays at 15 -->
          <TextBlock FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource VdfAccentTextBrush}">
            <Run FontSize="21" FontWeight="Bold" Text="{Binding TotalDuplicateGroups, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Verdict.Groups]}" />
            <Run Text=" · " />
            <Run FontSize="21" FontWeight="Bold" Text="{Binding TotalDuplicates, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.FilesUnit]}" />
            <Run Text=" · " />
            <Run FontSize="21" FontWeight="Bold" Text="{Binding PotentialSavings, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Verdict.Reclaimable]}" />
          </TextBlock>
          <!-- Second line: what the run looked at, so the numbers above have a scale.
               Results restored from a previous session have no scan figures — the whole
               line is dropped rather than claiming "Scanned 0 files". -->
          <StackPanel Orientation="Horizontal" IsVisible="{Binding !!ScannedFileCount}">
            <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}">
              <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Verdict.Scanned]}" />
              <Run Text=" " />
              <Run Text="{Binding ScannedFileCount, Mode=OneWay, StringFormat={}{0:N0}}" />
              <Run Text=" " />
              <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.FilesUnit]}" />
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                       IsVisible="{Binding TimeElapsed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Run Text=" · " />
              <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Stats.ElapsedTime]}" />
              <Run Text="{Binding TimeElapsed, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ======== First-results hint (one-shot, dismissible): thumbnails are small by
         default — point at the Preview drag handle and the thumbnail-width setting ======== -->
    <Border
        Grid.Row="1"
        Margin="0,7,0,0"
        Padding="2,0"
        Background="Transparent"
        IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=!ResultsHintDismissed}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Classes="group-action" FontSize="12"
                AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Welcome.Dismiss]}"
                Command="{Binding DismissResultsHintCommand}">
          <!-- The glyph is decoration and stays out of the translated text. -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Welcome.Dismiss]}" />
            <TextBlock Text="✕" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Classes="group-action" FontSize="12" Margin="0,0,6,0"
                Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Hint.OpenSettings]}"
                Command="{Binding ShowShellViewCommand}"
                CommandParameter="Settings" />
        <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource VdfMutedBrush}"
                   ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Hint.PreviewSize]}"
                   Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Hint.PreviewSize]}" />
      </DockPanel>
    </Border>

    <!-- ======== Toolbar (mockup .toolbar): one search field, the four facet counts, and
         sort on the right. VDF grew a dozen extra filters over the years; they moved to
         the advanced strip below instead of crowding this row. ======== -->
    <Border Grid.Row="2" Margin="0,10,0,4">
      <DockPanel LastChildFill="False">

        <!-- mockup .search: file name or path. Same reference implementations: the old
             TextBox bound FilterByPath, this one just looks like the prototype. -->
        <Border DockPanel.Dock="Left" Classes="searchbox" MinWidth="230">
          <DockPanel LastChildFill="True">
            <PathIcon
                DockPanel.Dock="Left"
                Width="15" Height="15"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource VdfMutedBrush}"
                Data="M 10.5 3 C 14.6 3 18 6.4 18 10.5 C 18 12.3 17.4 13.9 16.3 15.2 L 20.6 19.5 L 19.5 20.6 L 15.2 16.3 C 13.9 17.4 12.3 18 10.5 18 C 6.4 18 3 14.6 3 10.5 C 3 6.4 6.4 3 10.5 3 Z M 10.5 4.6 C 7.3 4.6 4.6 7.3 4.6 10.5 C 4.6 13.7 7.3 16.4 10.5 16.4 C 13.7 16.4 16.4 13.7 16.4 10.5 C 16.4 7.3 13.7 4.6 10.5 4.6 Z" />
            <TextBox
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                MinHeight="0"
                FontSize="13"
                VerticalAlignment="Center"
                Text="{Binding FilterByPath}"
                PlaceholderText="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.SearchWatermark]}"
                ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.PathNote]}" />
          </DockPanel>
        </Border>

        <!-- mockup .filters. Mutually exclusive, because the counts beside the labels
             are only meaningful when exactly one of them is on. The prototype's
             "ignored" bucket opens the blacklist manager: VDF removes those groups
             from the results entirely, so there is nothing here for it to filter. -->
        <Border DockPanel.Dock="Left" Classes="filtertrack" Margin="9,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Button Classes="filteritem" Classes.on="{Binding IsFacetAll}"
                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.All]}"
                    Command="{Binding SetResultsFacetCommand}" CommandParameter="All"
                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.AllTip]}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.All]}" />
                <TextBlock Classes="facetn" Text="{Binding ResultsAllGroupCount, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Classes="filteritem" Classes.on="{Binding IsFacetReview}"
                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.Review]}"
                    Command="{Binding SetResultsFacetCommand}" CommandParameter="Review"
                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.ReviewTip]}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.Review]}" />
                <TextBlock Classes="facetn" Text="{Binding ResultsReviewGroupCount, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Classes="filteritem" Classes.on="{Binding IsFacetConfident}"
                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.Confident]}"
                    Command="{Binding SetResultsFacetCommand}" CommandParameter="Confident"
                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.ConfidentTip]}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.Confident]}" />
                <TextBlock Classes="facetn" Text="{Binding ResultsConfidentGroupCount, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Classes="filteritem"
                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.Ignored]}"
                    Command="{Binding OpenBlacklistManagerCommand}"
                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.IgnoredTip]}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Facet.Ignored]}" />
                <TextBlock Classes="facetn" Text="{Binding BlacklistedGroupCount, Mode=OneWay}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Everything the toolbar gave up. The chip keeps its own state; nothing here
             changes what is filtered until it is opened. -->
        <ToggleButton
            DockPanel.Dock="Right"
            Classes="chip"
            IsChecked="{Binding ResultsAdvancedFiltersOpen}"
            Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.Advanced]}" />

        <!-- mockup sort button: the sort in force is its label, and pressing the mode
             that is already active flips the direction instead of doing nothing. -->
        <Button
            DockPanel.Dock="Right"
            Classes="ghostsm"
            Margin="0,0,9,0"
            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.Sort]}">
          <Button.Content>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding SelectedResultsSort.Name, Mode=OneWay}" />
              <TextBlock Text="&#9662;" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
          </Button.Content>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="WastedSpace"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.WastedSpace]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="TotalSize"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.TotalSize]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="LargestFile"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.LargestFile]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="FileCount"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.FileCount]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="Similarity"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.Similarity]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="DateCreated"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.DateCreated]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="Duration"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.Duration]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="Resolution"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.Resolution]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="FolderPath"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.FolderPath]}" />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="GroupsWithCheckedItems"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Sort.GroupsWithChecked]}" />
              <Separator />
              <MenuItem Command="{Binding SortResultsByCommand}" CommandParameter="Toggle"
                        Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.DescendingTip]}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </DockPanel>
    </Border>

    <!-- ======== Advanced filters. The card layout has no column heads to hang this on,
         so the old right-click column menu, the sort detail controls and the bulk selection
         menu live here, visible only when asked for. ======== -->
    <Border Grid.Row="3" Classes="advstrip" IsVisible="{Binding ResultsAdvancedFiltersOpen}">
      <StackPanel Spacing="10">

        <WrapPanel>
          <TextBlock x:Name="SortLabel" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.Sort]}" />
          <ComboBox
              MinWidth="170"
              FontSize="12"
              AutomationProperties.LabeledBy="{Binding #SortLabel}"
              ItemsSource="{Binding ResultsSortOptions}"
              SelectedItem="{Binding SelectedResultsSort}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultsSortOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton
              Classes="chip"
              Margin="4,0,0,0"
              IsChecked="{Binding ResultsSortDescending}"
              AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Results.SortDescending]}"
              Content="{Binding ResultsSortDescending, Converter={StaticResource SortDirectionGlyphConverter}}"
              ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.DescendingTip]}" />
          <ToggleButton
              Classes="chip"
              Margin="4,0,0,0"
              FontSize="12"
              IsChecked="{Binding ResultsBestFirst}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.BestFirst]}"
              ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.BestFirstTip]}" />
          <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource VdfCardLineBrush}" />
          <TextBlock x:Name="TypeLabel" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.Type]}" />
          <ComboBox
              MinWidth="100"
              FontSize="12"
              AutomationProperties.LabeledBy="{Binding #TypeLabel}"
              ItemsSource="{Binding TypeFilters}"
              SelectedItem="{Binding FileType}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="Settings:FileTypeFilterOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" FontSize="12"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.Similarity]}" />
          <NumericUpDown
              Width="110" FontSize="12"
              AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Results.SimilarityFrom]}"
              FormatString="\{0\}%" Maximum="100" Minimum="0"
              Value="{Binding FilterSimilarityFrom}" />
          <TextBlock Margin="4,0" VerticalAlignment="Center" FontSize="12"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.To]}" />
          <NumericUpDown
              Width="110" FontSize="12"
              AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Results.SimilarityTo]}"
              FormatString="\{0\}%" Maximum="100" Minimum="0"
              Value="{Binding FilterSimilarityTo}" />
        </WrapPanel>

        <WrapPanel>
          <ToggleButton
              Classes="chip"
              IsChecked="{Binding FilterGroupsWithCheckedItems}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.GroupsWithCheckedItems]}" />
          <ToggleButton
              Classes="chip"
              Margin="6,0,0,0"
              IsChecked="{Binding FilterHideGroupsWithOneFileLeft}"
              ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.HideGroupsWithOneFileLeftTooltip]}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.HideGroupsWithOneFileLeft]}" />
          <ToggleButton
              Classes="chip"
              Margin="6,0,0,0"
              IsVisible="{Binding ResultsShowAiMatchFilter}"
              IsChecked="{Binding FilterOnlyGroupsWithAiMatches}"
              ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.OnlyGroupsWithAiMatchesTooltip]}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Filter.OnlyGroupsWithAiMatches]}" />
          <ToggleButton
              Classes="chip"
              Margin="6,0,0,0"
              IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ResultsCompactRows}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.CompactRows]}" />
          <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource VdfCardLineBrush}" />
          <Button x:Name="AutoSelectButton" FontSize="12" Padding="10,3" CornerRadius="12"
                  AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.AutoSelect]}">
            <Button.Content>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.AutoSelect]}" />
                <TextBlock Text="&#9662;" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem IsEnabled="False" FontSize="11"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.AutoSelect.PerGroup]}" />
                <MenuItem
                    Command="{Binding CheckLowestQualityCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CheckLowestQuality]}" />
                <MenuItem
                    Command="{Binding CheckOldestCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CheckOldest]}" />
                <MenuItem
                    Command="{Binding CheckNewestCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CheckNewest]}" />
                <MenuItem IsEnabled="False" FontSize="11"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.AutoSelect.AcrossResults]}" />
                <MenuItem
                    Command="{Binding CheckWhenIdenticalCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CheckIdenticalKeepFirst]}" />
                <MenuItem
                    Command="{Binding CheckWhenIdenticalButSizeCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CheckIdenticalExceptSizeKeepSmallest]}" />
                <MenuItem
                    Command="{Binding CheckMissingFilesCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CheckMissingFiles]}" />
                <Separator />
                <MenuItem
                    Command="{Binding CheckCustomCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.ExpressionBuilder]}" />
                <MenuItem x:Name="SavedExpressionsMenu" IsVisible="False"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.SavedExpressions]}" />
                <MenuItem
                    Command="{Binding OpenCustomSelectionCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.CustomSelection]}" />
                <Separator />
                <MenuItem
                    Command="{Binding InvertCheckedItemsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.InvertCheckedItems]}" />
                <MenuItem
                    Command="{Binding ClearCheckedItemsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.ClearCheckedItems]}" />
                <MenuItem
                    Command="{Binding UndoSelectionCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Shortcut.UndoSelection]}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>

        <!-- What is shown per row: the same switches the old column-header menu held.
             Preview width used to be dragged on the header row; the grip has no column
             head to sit on anymore, so it became a slider. -->
        <WrapPanel>
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowThumbnailColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.Preview]}" />
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowSimilarityColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.Match]}" />
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowDurationColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.DurationRes]}" />
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowSizeDateColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.SizeDate]}" />
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowBitrateColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.Bitrate]}" />
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowFormatColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.FormatAudio]}" />
          <CheckBox Margin="0,0,12,0" FontSize="12"
                    IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowLanguagesColumn}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Header.Languages]}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Toolbar.PreviewWidth]}" />
            <Slider Width="120" Minimum="40" Maximum="320"
                    VerticalAlignment="Center"
                    Value="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ResultsPreviewWidth}" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- ======== Flattened results list. The floating action dock (below) shares this
         row and overlays its bottom edge, so checking items never resizes the list. -->
    <ListBox
        x:Name="ResultsList"
        Grid.Row="4"
        AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Results.List]}"
        Classes="results"
        Background="Transparent"
        Padding="0"
        TemplateApplied="OnResultsListTemplateApplied"
        ContainerPrepared="OnResultsContainerPrepared"
        ContainerClearing="OnResultsContainerClearing"
        ItemsSource="{Binding ResultsRows}"
        SelectionMode="Multiple"
        SelectionChanged="OnResultsSelectionChanged"
        PointerPressed="OnResultsPointerPressed"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.DataTemplates>

        <!-- ~~~~ Group header row ~~~~ -->
        <DataTemplate DataType="vm:ResultsGroupHeader">
          <!-- The page brush covers the whole item on purpose: the header owns the 14px gap
               that separates two groups (the margin on Border.cardtop), and anything the item
               or the theme paints behind it lands in that gap as a band above the card. -->
           <Panel Background="{DynamicResource VdfPageBrush}">
            <!-- The mockup's group card, spelled out over consecutive list rows: this row
                 draws the top edge and the rounded shoulders, every member row carries the
                 side edges, and whoever ends the group closes the bottom. Head and callout
                 both belong to this one row, so they stack. -->
            <StackPanel>
              <Border Classes="cardtop" Classes.rowend="{Binding IsGroupEnd}" Margin="0,10,0,0">
                <Border.ContextMenu>
              <ContextMenu>
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).MarkGroupHeaderNotAMatchCommand}"
                    CommandParameter="{Binding}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.MarkNotMatch]}"
                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.MarkNotMatchTooltip]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).LoadThumbnailsForGroupHeaderCommand}"
                    CommandParameter="{Binding}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.LoadThumbnailsForGroup]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CompareMetadataOfGroupHeaderCommand}"
                    CommandParameter="{Binding}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MetadataCompare.Menu]}" />
                <Separator />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).KeepBestInGroupHeaderCommand}"
                    CommandParameter="{Binding}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.KeepBest]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CheckAllInGroupHeaderCommand}"
                    CommandParameter="{Binding}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.CheckAll]}" />
                <Separator />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ExpandAllGroupsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.ExpandAll]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CollapseAllGroupsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.CollapseAll]}" />
              </ContextMenu>
            </Border.ContextMenu>
                <DockPanel LastChildFill="True">
                  <!-- Collapsing has no room of its own in the mockup; the group number
                       took its place, and this stays in front of it. -->
                  <Button
                      DockPanel.Dock="Left"
                      Classes="group-action chevron"
                      Classes.collapsed="{Binding IsCollapsed}"
                      Width="24"
                      Padding="0"
                      Margin="0,0,6,0"
                      Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleGroupCollapsedCommand}"
                      CommandParameter="{Binding}">
                    <Panel>
                      <Path Classes="chevglyph" Data="{StaticResource ChevronDownGeometry}" IsVisible="{Binding !IsCollapsed}" />
                      <Path Classes="chevglyph" Data="{StaticResource ChevronRightGeometry}" IsVisible="{Binding IsCollapsed}" />
                    </Panel>
                  </Button>
                  <!-- mockup .group-idx -->
                  <Border DockPanel.Dock="Left" Classes="idxbadge">
                    <TextBlock Text="{Binding GroupNumber}" />
                  </Border>
                  <!-- mockup .group-head right cluster: what the machine thinks, then what
                       it offers to do about it -->
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                              Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- Combined-mode badges (#842): which classic algorithm(s) confirmed
                         this group. Only ever set by the combined grayscale+pHash scan. -->
                    <Border Classes="simchip" Padding="5,0" CornerRadius="3"
                            IsVisible="{Binding HasGrayscaleMatches}"
                            ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.GrayscaleTip]}">
                      <TextBlock FontSize="10" FontWeight="Bold"
                                 Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.Grayscale]}" />
                    </Border>
                    <Border Classes="simchip" Padding="5,0" CornerRadius="3"
                            IsVisible="{Binding HasPHashMatches}"
                            ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.PHashTip]}">
                      <TextBlock FontSize="10" FontWeight="Bold"
                                 Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.PHash]}" />
                    </Border>
                    <!-- mockup .ai-tag -->
                    <Border Classes="aitag" IsVisible="{Binding HasAiMatches}"
                            ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.AiMatchedTooltip]}">
                      <TextBlock Text="AI" />
                    </Border>
                    <!-- mockup .chip.chip-accent -->
                    <Border Classes="simchip" Padding="7,2" CornerRadius="99">
                      <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                 Text="{Binding SimilarityRangeDisplay}" />
                    </Border>
                    <Button
                        Classes="fileact"
                        Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CompareGroupHeaderCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.Compare]}" />
                    <Button
                        Classes="fileact"
                        Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).KeepBestInGroupHeaderCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.KeepBest]}" />
                  </StackPanel>
                  <!-- mockup .group-name / .group-meta: title over summary, one fact less
                       per line than the old header packed them side by side -->
                  <StackPanel Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                               Text="{Binding Summary}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <!-- mockup .callout: an AI-found group is a suggestion, not a verdict. The
                   classic hash check could not confirm the pair, so say so before the user
                   checks files off - a wrongly deleted original is not recoverable. The
                   strip lives inside the group card, so its row keeps the card surface
                   behind the amber panel instead of punching a hole in it. -->
              <Panel IsVisible="{Binding HasAiMatches}">
                <Border Classes="cardseg" />
                <Border Classes="callout">
                <DockPanel LastChildFill="True">
                  <TextBlock
                      DockPanel.Dock="Left"
                      Margin="0,0,9,0"
                      FontSize="14"
                      VerticalAlignment="Top"
                      Foreground="{DynamicResource VdfWarnBrush}"
                      Text="&#9888;" />
                  <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource VdfWarnBrush}"
                        Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.AiCallout.Title]}" />
                    <TextBlock
                        FontSize="12"
                        TextWrapping="Wrap"
                        Opacity="{DynamicResource VdfTextSoftOpacity}"
                        Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.AiCallout.Body]}" />
                  </StackPanel>
                </DockPanel>
                </Border>
              </Panel>
            </StackPanel>
            <Border Classes="selframe" />
          </Panel>
        </DataTemplate>

        <!-- ~~~~ File row ~~~~ -->
        <DataTemplate DataType="vm:ResultsItemRow">
          <Panel>
            <!-- mockup .file: one member of the group card. These rows carry the card's
                 side edges; IsGroupEnd closes it, which the builder flags on the last
                 entry of every group. -->
            <Border
                Classes="cardseg grouprow"
                Classes.checked="{Binding Item.Checked}"
                Classes.rowend="{Binding IsGroupEnd}"
                Padding="16,7"
                PointerPressed="OnResultRowPointerPressed"
                DoubleTapped="OnResultRowDoubleTapped">
              <Border.ContextMenu>
              <ContextMenu>
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).OpenItemCommand}"
                    CommandParameter="{Binding Item}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.OpenFile]}"
                    InputGesture="{Binding Source={x:Static Settings:KeyboardShortcutManager.Instance}, Path=[OpenItemsByColId]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).OpenItemInFolderCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.OpenInFolder]}"
                    InputGesture="{Binding Source={x:Static Settings:KeyboardShortcutManager.Instance}, Path=[OpenItemInFolder]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).RenameFileCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RenameFile]}"
                    InputGesture="{Binding Source={x:Static Settings:KeyboardShortcutManager.Instance}, Path=[RenameFile]}" />
                <!-- Moves the highlighted row(s) with database path tracking - unlike the
                     action bar's move, this doesn't require checking the file (checked
                     means "delete"; the file you relocate is usually the keeper) (#843). -->
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).MoveSelectedItemsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.MoveToFolderEllipsis]}" />
                <Separator />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleCheckboxCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Row.ToggleCheck]}"
                    InputGesture="{Binding Source={x:Static Settings:KeyboardShortcutManager.Instance}, Path=[ToggleCheckbox]}" />
                <!-- Both are mouse-only on the row itself: the details button cannot be
                     tabbed to inside a list, and the differences show on hover. -->
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleItemDetailsCommand}"
                    CommandParameter="{Binding Item}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Row.DetailsTip]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleGroupDiffsCommand}"
                    CommandParameter="{Binding Item}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Row.CompareWithBest]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CopyPathsToClipboardCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.CopyPaths]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CopyFilenamesToClipboardCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.CopyFilenames]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).RemoveSingleItemCommand}"
                    CommandParameter="{Binding Item}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListOnly]}" />
                <Separator />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CompareGroupHeaderCommand}"
                    CommandParameter="{Binding Group}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.CompareFullsizeThumbnails]}"
                    InputGesture="{Binding Source={x:Static Settings:KeyboardShortcutManager.Instance}, Path=[ShowGroupInThumbnailComparer]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CompareMetadataOfGroupHeaderCommand}"
                    CommandParameter="{Binding Group}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MetadataCompare.Menu]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CheckAllInGroupHeaderCommand}"
                    CommandParameter="{Binding Group}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Group.CheckAll]}" />
                <MenuItem
                    Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).MarkGroupHeaderNotAMatchCommand}"
                    CommandParameter="{Binding Group}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.MarkNotMatch]}"
                    InputGesture="{Binding Source={x:Static Settings:KeyboardShortcutManager.Instance}, Path=[MarkGroupAsNotAMatch]}" />
              </ContextMenu>
            </Border.ContextMenu>
              <DockPanel LastChildFill="True">
                <!-- The mockup's checkbox is 20x20 and rounded; what matters is that
                     checked reads as "will be deleted", so its a11y name says exactly
                     that rather than repeating the file name. -->
                <!-- The 13px gap is the mockup's .file gap: the box, then the preview.
                     It was 10px, which is not a gap the mockup uses between two parts
                     of a row. -->
                <CheckBox
                    DockPanel.Dock="Left"
                    Width="24"
                    Margin="0,0,13,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Item.Checked}">
                  <AutomationProperties.Name>
                    <MultiBinding StringFormat="{}{0}: {1}">
                      <Binding Source="{x:Static local:App.Lang}" Path="[A11y.Row.MarkForDeletion]" />
                      <Binding Path="Item.ItemInfo.Path" Converter="{StaticResource FileNameConverter}" />
                    </MultiBinding>
                  </AutomationProperties.Name>
                </CheckBox>
                <!-- preview filmstrip - Tag=Preview: keeps its own click (opens the file)
                     and its own double-tap, so the row's empty-space handler must not
                     claim clicks inside it. The column hugs the frames instead of
                     reserving the whole preview width, which left the leftover blank
                     sitting between the picture and the file name. -->
                <Grid DockPanel.Dock="Left"
                      Tag="Preview"
                      Margin="0,0,13,0"
                      PointerPressed="OnPreviewPointerPressed"
                      IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowThumbnailColumn}">
                  <Grid.Width>
                    <MultiBinding Converter="{StaticResource ResultsRowSizingConverter}" ConverterParameter="width">
                      <Binding Source="{x:Static Settings:SettingsFile.Instance}" Path="ResultsPreviewWidth" />
                      <Binding Source="{x:Static Settings:SettingsFile.Instance}" Path="ResultsCompactRows" />
                      <Binding Path="Item.Thumbnail" />
                      <Binding Path="Item.ThumbnailFrameCount" />
                      <Binding Path="Item.ThumbnailGridColumns" />
                      <Binding Path="Item.ThumbnailPrediction" />
                    </MultiBinding>
                  </Grid.Width>
                  <Border
                      Classes="skeleton-shimmer"
                      Margin="0,2,0,2"
                      Background="#18808080">
                    <Border.Height>
                      <MultiBinding Converter="{StaticResource ResultsRowSizingConverter}" ConverterParameter="image">
                        <Binding Source="{x:Static Settings:SettingsFile.Instance}" Path="ResultsPreviewWidth" />
                        <Binding Source="{x:Static Settings:SettingsFile.Instance}" Path="ResultsCompactRows" />
                        <Binding Path="Item.ThumbnailPrediction" />
                      </MultiBinding>
                    </Border.Height>
                    <Border.IsVisible>
                      <MultiBinding Converter="{StaticResource ShowSkeletonConverter}">
                        <Binding Path="Item.Thumbnail" />
                        <Binding Source="{x:Static Settings:SettingsFile.Instance}" Path="GeneratePreviewThumbnails" />
                      </MultiBinding>
                    </Border.IsVisible>
                  </Border>
                  <ctl:WrappedFilmstrip
                      Source="{Binding Item.Thumbnail}"
                      FrameCount="{Binding Item.ThumbnailFrameCount}"
                      GridColumns="{Binding Item.ThumbnailGridColumns}"
                      Compact="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ResultsCompactRows}"
                      Margin="0,2,0,2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      DoubleTapped="OnThumbnailDoubleTapped"
                      ToolTip.Tip="{Binding Item.ItemInfo.Path}" />
                </Grid>
                <!-- mockup .file-acts. Revealed on row hover: they are what you do to the
                     row you are pointing at, and keeping them out of the layout leaves
                     the file name and its badges their full width. Keyed off the
                     ListBoxItem, whose bounds never change, so showing them cannot
                     flicker under the pointer. Opening the file needs no button — the
                     preview is the target, as in the mockup — and the details panel
                     needs none either: it was a second button of its own kind, so the
                     row carries the single action a member has. The panel is still on the
                     row's context menu for anyone who wants it. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            IsVisible="{Binding $parent[ListBoxItem].IsPointerOver}">
                  <Button
                      Classes="fileact"
                      Padding="8,3"
                      AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Row.Reveal]}"
                      ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.OpenInFolder]}"
                      Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).RevealRowItemCommand}"
                      CommandParameter="{Binding Item}">
                    <PathIcon Width="14" Height="14"
                              Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                  </Button>
                </StackPanel>
                <!-- The similarity chip is a value, not an action: it stays put whether or
                     not the pointer is on the row, so the numbers never jump. -->
                <!-- mockup .keep-tag / .keep-reason: why this one would be kept, and
                     every other state a member can be in. They belong on the same line as
                     the similarity value: docked to the name line above they sat on a
                     different baseline from the chip, which left the pair visibly
                     staggered. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                            Margin="6,0,0,0" VerticalAlignment="Center">
                  <Border Classes="keeptag" IsVisible="{Binding IsBest}"
                          ToolTip.Tip="{Binding BestTooltip}">
                    <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Row.Best]}" />
                  </Border>
                  <Border Classes="keeptag" IsVisible="{Binding Item.ItemInfo.IsAiMatched}"
                          ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Results.AiMatchedTooltip]}">
                    <TextBlock Text="AI" />
                  </Border>
                  <Border IsVisible="{Binding Item.IsTombstone}"
                          Background="{DynamicResource VdfTombBrush}"
                          CornerRadius="3" Padding="5,0" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[DupList.AlreadyDeletedTooltip]}">
                    <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[DupList.AlreadyDeleted]}"
                               FontSize="10" FontWeight="Bold" Foreground="White" />
                  </Border>
                  <Border IsVisible="{Binding Item.IsOffline}"
                          Background="{DynamicResource VdfMutedSoftBrush}"
                          BorderBrush="{DynamicResource VdfMutedBorderBrush}" BorderThickness="1"
                          CornerRadius="3" Padding="5,0" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[DupList.OfflineTooltip]}">
                    <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[DupList.Offline]}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource VdfMutedBrush}" />
                  </Border>
                  <Border
                      Classes="simchip"
                      Classes.mid="{Binding Item.ItemInfo.Similarity, Converter={StaticResource SimilarityTierConverter}, ConverterParameter=mid}"
                      Classes.low="{Binding Item.ItemInfo.Similarity, Converter={StaticResource SimilarityTierConverter}, ConverterParameter=low}"
                      Padding="7,2"
                      CornerRadius="99"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowSimilarityColumn}">
                    <TextBlock
                        FontSize="11.5"
                        FontWeight="Bold"
                        Text="{Binding Item.ItemInfo.Similarity, Converter={StaticResource SimilarityToFormattedConverter}}" />
                  </Border>
                </StackPanel>
                <!-- mockup .file-info: name and badges on top, the facts underneath -->
                <StackPanel Margin="0" VerticalAlignment="Center" Spacing="3">
                  <!-- The name may wrap to a second line in comfortable mode before it
                       trims: with a wide preview or a narrow window a single line cut
                       long names down to a few characters (#854). Capped at two lines
                       so pathological names can't blow up the row; the full name stays
                       in the tooltip. -->
                   <TextBlock
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VdfTextBrush}"
                      HorizontalAlignment="Left"
                      TextWrapping="Wrap"
                      MaxLines="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ResultsCompactRows, Converter={StaticResource FileNameMaxLinesConverter}}"
                      TextTrimming="CharacterEllipsis"
                      Text="{Binding Item.ItemInfo.Path, Converter={StaticResource FileNameConverter}}"
                      ToolTip.Tip="{Binding Item.ItemInfo.Path, Converter={StaticResource FileNameConverter}}" />
                  <!-- mockup .file-specs. Same numbers the old six fixed-width columns
                       held, read left to right in one line; each block owns its leading
                       separator so switching a column off takes its dot with it. Hovering
                       a value still swaps it against the group's best one. -->
                  <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowDurationColumn}">
                      <TextBlock Classes="specsep" />
                      <Border Background="Transparent" Tag="duration,framesize"
                              PointerEntered="OnMetricPointerEntered" PointerExited="OnMetricPointerExited">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                     Classes="metric-diff"
                                     IsVisible="{Binding !Item.ItemInfo.IsImage}"
                                     Classes.hi="{Binding DurationHi}"
                                     Classes.lo="{Binding DurationLo}"
                                     Classes.eq="{Binding Item.DurationDiff, Converter={StaticResource EqualDiffConverter}}"
                                     Classes.diffing="{Binding Item.DurationDiff, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource MetricDisplayConverter}" ConverterParameter="{}{0:hh\:mm\:ss}">
                                <Binding Path="Item.ItemInfo.Duration" />
                                <Binding Path="Item.DurationDiff" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                          <StackPanel Orientation="Horizontal" Spacing="5">
                             <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                        MinWidth="76"
                                        Classes="metric-diff"
                                        Classes.hi="{Binding FrameSizeHi}"
                                       Classes.lo="{Binding FrameSizeLo}"
                                       Classes.eq="{Binding Item.FrameSizeDiff, Converter={StaticResource EqualDiffConverter}}"
                                       Classes.diffing="{Binding Item.FrameSizeDiff, Converter={x:Static ObjectConverters.IsNotNull}}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource MetricDisplayConverter}">
                                  <Binding Path="Item.ItemInfo.FrameSize" />
                                  <Binding Path="Item.FrameSizeDiff" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <!-- HDR chip: neutral information; green only when this member's
                                 format outranks another member of the group -->
                            <Border Classes="hdrchip" Classes.best="{Binding HdrIsUpgrade}"
                                    IsVisible="{Binding Item.ItemInfo.HdrFormat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding Item.ItemInfo.HdrFormat}" />
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowSizeDateColumn}">
                      <TextBlock Classes="specsep" />
                      <Border Tag="size" Background="Transparent"
                              PointerEntered="OnMetricPointerEntered" PointerExited="OnMetricPointerExited">
                        <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                   MinWidth="60"
                                   Classes="metric-diff"
                                   Classes.hi="{Binding SizeHi}"
                                   Classes.lo="{Binding SizeLo}"
                                   Classes.eq="{Binding Item.SizeDiff, Converter={StaticResource EqualDiffConverter}}"
                                   Classes.diffing="{Binding Item.SizeDiff, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource MetricDisplayConverter}">
                              <Binding Path="Item.ItemInfo.Size" />
                              <Binding Path="Item.SizeDiff" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </Border>
                      <TextBlock Classes="specsep" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                 Text="{Binding Item.ShownDate, Converter={StaticResource ExtraShortDateTimeConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowFormatColumn}">
                      <TextBlock Classes="specsep" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                 Text="{Binding Item.ItemInfo.Format, TargetNullValue=''}" />
                      <Border Tag="fps" Background="Transparent" IsVisible="{Binding !Item.ItemInfo.IsImage}"
                              PointerEntered="OnMetricPointerEntered" PointerExited="OnMetricPointerExited">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Classes="specsep" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                     Classes="metric-diff"
                                     Classes.diffing="{Binding Item.FpsDiff, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource MetricDisplayConverter}" ConverterParameter="{}{0} fps">
                                <Binding Path="Item.ItemInfo.Fps" />
                                <Binding Path="Item.FpsDiff" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowBitrateColumn}">
                      <TextBlock Classes="specsep" />
                      <Border Background="Transparent" Tag="bitrate,audiobitrate"
                              PointerEntered="OnMetricPointerEntered" PointerExited="OnMetricPointerExited">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                     Classes="metric-diff"
                                     IsVisible="{Binding !Item.ItemInfo.IsImage}"
                                     Classes.hi="{Binding BitRateHi}"
                                     Classes.lo="{Binding BitRateLo}"
                                     Classes.eq="{Binding Item.BitRateDiff, Converter={StaticResource EqualDiffConverter}}"
                                     Classes.diffing="{Binding Item.BitRateDiff, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource MetricDisplayConverter}">
                                <Binding Path="Item.ItemInfo.BitRateKbs" Converter="{StaticResource BitrateDisplayConverter}" />
                                <Binding Path="Item.BitRateDiff" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                          <TextBlock Classes="specsep" IsVisible="{Binding !Item.ItemInfo.IsImage}" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                     Classes="metric-diff"
                                     IsVisible="{Binding !Item.ItemInfo.IsImage}"
                                     Classes.hi="{Binding AudioBitRateHi}"
                                     Classes.lo="{Binding AudioBitRateLo}"
                                     Classes.eq="{Binding Item.AudioBitRateDiff, Converter={StaticResource EqualDiffConverter}}"
                                     Classes.diffing="{Binding Item.AudioBitRateDiff, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource MetricDisplayConverter}">
                                <Binding Path="Item.ItemInfo.AudioBitRateKbs" Converter="{StaticResource BitrateDisplayConverter}" />
                                <Binding Path="Item.AudioBitRateDiff" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowFormatColumn}">
                      <TextBlock Classes="specsep" IsVisible="{Binding !Item.ItemInfo.IsImage}" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                 IsVisible="{Binding !Item.ItemInfo.IsImage}"
                                 Text="{Binding Item.ItemInfo.AudioFormat, TargetNullValue=''}" />
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Classes="specsep" IsVisible="{Binding !Item.ItemInfo.IsImage}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                   IsVisible="{Binding !Item.ItemInfo.IsImage}"
                                   Text="{Binding Item.ItemInfo.AudioChannel, TargetNullValue=''}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=ShowLanguagesColumn}">
                      <TextBlock Classes="specsep" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                 IsVisible="{Binding Item.ItemInfo.AudioLanguages, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Text="{Binding Item.ItemInfo.AudioLanguages}" />
                      <TextBlock Classes="specsep" IsVisible="{Binding Item.ItemInfo.SubtitleLanguages, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                 IsVisible="{Binding Item.ItemInfo.SubtitleLanguages, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Text="{Binding Item.ItemInfo.SubtitleLanguages}" />
                    </StackPanel>
                    <!-- Clip offset: where a partial clip sits inside the longer source. -->
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                IsVisible="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ResultsShowClipOffsetColumn}">
                      <TextBlock Classes="specsep" IsVisible="{Binding Item.ItemInfo.PartialClipOffsetDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource VdfMutedBrush}"
                                 Text="{Binding Item.ItemInfo.PartialClipOffsetDisplay}" />
                    </StackPanel>
                  </WrapPanel>
                  <!-- Full path: the row was already two lines deep, so this one stays.
                       Click-to-copy fires on an already-selected row (#849). -->
                  <Border
                      Background="Transparent"
                      Tag="PathLine"
                      IsVisible="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=!ResultsCompactRows}"
                      ToolTip.Tip="{Binding Item.ItemInfo.Path}"
                      PointerPressed="OnPathPointerPressed">
                    <DockPanel>
                      <TextBlock
                          DockPanel.Dock="Right"
                          Margin="8,0,0,0"
                          FontSize="11.5"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource VdfGoodBrush}"
                          IsVisible="{Binding Item.PathCopiedFlash}"
                          Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Row.PathCopied]}" />
                      <ctl:MiddleEllipsisTextBlock
                          FontSize="11.5"
                          Foreground="{DynamicResource VdfMutedBrush}"
                          Text="{Binding Item.ItemInfo.Path, Converter={StaticResource DirectoryPathConverter}}" />
                    </DockPanel>
                  </Border>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Classes="selframe" />
          </Panel>
        </DataTemplate>

        <!-- ~~~~ Details panel (Tier 2 metadata, expanded via ⓘ) ~~~~ -->
        <DataTemplate DataType="vm:ResultsDetailsRow">
          <!-- The panel opens inside the group card: it keeps the card surface behind
               itself, and when it is the group's last row (the builder flags it the same
               way it flags a member) it is the piece that closes the card. -->
          <Panel>
            <Border Classes="cardseg" Classes.rowend="{Binding IsGroupEnd}" />
            <Border Classes="detailsrow" Margin="36,2,16,6" Padding="14,8" CornerRadius="8"
                    Background="{DynamicResource VdfSunkenBrush}"
                    BorderBrush="{DynamicResource VdfCardLineBrush}"
                    BorderThickness="1">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Classes="group-action" FontSize="11.5"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Details.Copy]}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CopyItemDetailsCommand}"
                        CommandParameter="{Binding Item}" />
              </StackPanel>
              <WrapPanel>
                <StackPanel Margin="0,0,26,2" MinWidth="220">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="colheader" IsVisible="{Binding !IsImage}"
                               Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Details.Video]}" />
                    <TextBlock Classes="colheader" IsVisible="{Binding IsImage}"
                               Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Details.Image]}" />
                  </StackPanel>
                  <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap" Text="{Binding VideoText}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,2" MinWidth="180" IsVisible="{Binding HasAudio}">
                  <TextBlock Classes="colheader"
                             Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Details.Audio]}" />
                  <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap" Text="{Binding AudioText}" />
                  <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap"
                             IsVisible="{Binding HasAudioLanguages}" Text="{Binding AudioLanguagesText}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,2" MinWidth="120" IsVisible="{Binding HasSubtitles}">
                  <TextBlock Classes="colheader"
                             Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Details.Subtitles]}" />
                  <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap" Text="{Binding SubtitlesText}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,2" MinWidth="160">
                  <TextBlock Classes="colheader"
                             Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Details.File]}" />
                  <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap" Text="{Binding FileText}" />
                </StackPanel>
              </WrapPanel>
            </DockPanel>
          </Border>
          </Panel>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>

    <!-- ======== Floating action dock (mockup .dock). It shares the list's grid row and
         pins itself to the bottom, so it hovers over the last rows instead of taking
         height from the list: checking items must not resize the rows being read. ======== -->
    <!-- Mockup .dock: 32px from the page's own edges and 22px off the bottom, the r-xl
         radius (26px), and its padding 13px 16px 13px 22px — the wider inset on the left
         is what keeps the sentence off the curve. It was 28px/16px at radius 16. -->
    <Border
        Grid.Row="4"
        IsVisible="{Binding !!DuplicatesCheckedCounter}"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Stretch"
        MaxWidth="1016"
        Margin="32,0,32,22"
        Padding="22,13,16,13"
        CornerRadius="26"
        Background="{DynamicResource VdfCardBrush}"
        BorderBrush="{DynamicResource VdfMutedBorderBrush}"
        BorderThickness="1"
        BoxShadow="0 8 22 0 #26003050">
      <!-- Two rows instead of one: the hint used to share the row and lost. -->
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="7">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12.5"
                   Opacity="{DynamicResource VdfTextDim85Opacity}">
          <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Dock.Selected]}" />
          <Run Text=" " />
          <Run FontSize="15" FontWeight="SemiBold" Text="{Binding DuplicatesCheckedCounter, Mode=OneWay}" />
          <Run Text=" " />
          <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.FilesUnit]}" />
          <Run Text=" · " />
          <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Dock.WillFree]}" />
          <Run Text=" " />
          <Run FontSize="15" FontWeight="SemiBold"
               Foreground="{DynamicResource VdfAccentTextBrush}"
               Text="{Binding DuplicatesCheckedSize, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button
              Classes="solid"
              Background="{DynamicResource VdfDangerSolidBrush}"
              Foreground="White"
              FontSize="12.5"
              FontWeight="SemiBold"
              Padding="14,5"
              AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Results.Action.Delete]}">
            <Button.Content>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Action.Delete]}" />
                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem
                    Command="{Binding DeleteCheckedItemsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.DeleteFromDiskRecycle]}" />
                <MenuItem
                    Command="{Binding DeleteCheckedItemsPermanentlyCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.DeletePermanently]}" />
                <Separator />
                <MenuItem
                    Command="{Binding CopyCheckedItemsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.CopyToFolderEllipsis]}" />
                <MenuItem
                    Command="{Binding MoveCheckedItemsCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.MoveToFolderEllipsis]}" />
                <Separator />
                <MenuItem
                    Command="{Binding ExportCheckedItemsCleanupDryRunReportCommand}"
                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Selection.ExportCheckedItemsCleanupDryRun]}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <!-- The "remove from list" dropdown used to sit here, between delete and
               clear-selection. At this window width the dock's own row came out wider
               than the list, and the theme clipped whatever fell past the edge - the
               hint at the right was the casualty. The dropdown was the widest thing in
               the row and the least used (the user asked for it gone); its six actions
               moved to the ⋯ menu's "checked items" section, which has the room and is
               already where the infrequent commands live. -->
          <Button
              FontSize="12.5"
              Padding="14,5"
              Command="{Binding ClearCheckedItemsCommand}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Results.Action.ClearSelection]}" />
        </StackPanel>
        <!-- The hint has a line of its own now. Sharing the row made it the first thing to
             give way at the window's narrow end, where a shortened sentence reads as a bug;
             full width it always says what it means. -->
        <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="2"
            FontSize="12"
            TextWrapping="Wrap"
            Opacity="{DynamicResource VdfTextFaintOpacity}"
            Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Action.Hint]}" />
      </Grid>
    </Border>

    <!-- ======== Statusline (mockup .statusline): results stats, Review only.
         Checked count/size live in the action bar; scan progress lives in the
         Scanning state. Thumbnail loading (#791) stays visible here. ======== -->
    <Border
        Grid.Row="5"
        Padding="10,4"
        BorderBrush="{DynamicResource VdfCardLineBrush}"
        BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextFaintOpacity}">
            <Run Text="{Binding TotalDuplicateGroups, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Status.Groups]}" />
            <Run Text="· " /><Run Text="{Binding TotalDuplicates, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Status.Duplicates]}" />
            <Run Text="· " /><Run Text="{Binding TotalDuplicatesSize, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Status.TotalSize]}" />
          </TextBlock>
          <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextFaintOpacity}"
                     ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Stats.PotentialSavingsTooltip]}">
            <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Stats.PotentialSavings]}" />
            <Run Text="{Binding PotentialSavings, Mode=OneWay}" />
          </TextBlock>
          <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextFaintOpacity}">
            <Run Text="{Binding TotalSizeRemoved, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Results.Status.RemovedSuffix]}" />
          </TextBlock>
        </StackPanel>
        <!-- determinate thumbnail-load progress (#791) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowThumbnailRetrievalProgress}">
          <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextFaintOpacity}" VerticalAlignment="Center"
                     Text="{Binding ThumbnailRetrievalProgressText}" />
          <ProgressBar Width="90" Height="5"
                       AutomationProperties.Name="{Binding ThumbnailRetrievalProgressText}"
                       IsIndeterminate="{Binding !ThumbnailProgressMax}"
                       Maximum="{Binding ThumbnailProgressMax, Mode=OneWay}"
                       Value="{Binding ThumbnailProgressCurrent, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
