<Window
    x:Class="VDF.GUI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Settings="clr-namespace:VDF.GUI.Data;assembly=VDF.GUI"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
    xmlns:ctl="clr-namespace:VDF.GUI.Controls;assembly=VDF.GUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
    xmlns:ic="clr-namespace:Avalonia.Xaml.Interactions.Custom;assembly=Xaml.Behaviors.Interactions.Custom"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:presenters="clr-namespace:Avalonia.Controls.Presenters;assembly=Avalonia.Controls"
    xmlns:utils="clr-namespace:VDF.GUI.Utils;assembly=VDF.GUI"
    xmlns:views="clr-namespace:VDF.GUI.Views;assembly=VDF.GUI"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels;assembly=VDF.GUI"
    x:DataType="vm:MainWindowVM"
    x:Name="MainWindow"
    Width="1020"
    Height="950"
    MinWidth="750"
    MinHeight="450"
    d:DesignHeight="750"
    d:DesignWidth="900"
    Background="{DynamicResource VdfRailBrush}"
    BorderBrush="{DynamicResource VdfCardLineBrush}"
    BorderThickness="1"
    ExtendClientAreaToDecorationsHint="True"
    FontSize="14"
    Icon="/Assets/icon.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Title>
        <!-- Localized app title plus the build identity (e.g. "… 4.1.0 (a225a45)").
             Releases roll to one tag, so the commit is the meaningful version. -->
        <MultiBinding StringFormat="{}{0}  —  {1}">
            <Binding Path="[App.Title]" Source="{x:Static local:App.Lang}" />
            <Binding Source="{x:Static utils:VersionInfo.ShortDisplay}" />
        </MultiBinding>
    </Window.Title>
    <Window.Resources>
        <mvvm:ExtraShortDateTimeConverter x:Key="ExtraShortDateTimeConverter" />
        <mvvm:SimilarityToFormattedConverter x:Key="SimilarityToFormattedConverter" />
        <mvvm:MetricDisplayConverter x:Key="MetricDisplayConverter" />
        <mvvm:ShowSkeletonConverter x:Key="ShowSkeletonConverter" />
        <mvvm:StringEqualsConverter x:Key="StringEqualsConverter" />
    </Window.Resources>
    <Window.Styles>
        <!-- ===== Window caption buttons (the window's own top-right corner) =====
             Avalonia 12 draws managed caption buttons when the client area is extended
             (ExtendClientAreaChromeHints/PreferSystemChrome no longer exists), and its set
             carries a full-screen toggle Windows chrome never had. Left alone they read as
             grey slabs over the page, so they are redrawn as the theme's own quiet 45x31
             plates: transparent, dimmed ink, soft accent under the pointer, red on close.
             The full-screen button is collapsed to nothing, which is what keeps the other
             three flush with the window edge.
             NOTE: styling these through ":pointerover /template/" selectors breaks the
             window's own template attach (the window never shows), so the hover states
             ride on the button's own properties instead. -->
        <Style Selector="Button#PART_MinimizeButton, Button#PART_RestoreButton, Button#PART_CloseButton">
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="{DynamicResource VdfTextSecondaryOpacity}" />
        </Style>
        <Style Selector="Button#PART_MinimizeButton:pointerover, Button#PART_RestoreButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button#PART_CloseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource VdfDangerSolidBrush}" />
            <!-- White on red in every theme: the on-accent ink is dark in the dark theme,
                 right for a light accent tile and unreadable on red. -->
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.hyperlink">
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock:pointerover">
                                <Setter Property="Foreground" Value="{actipro:ThemeResource ControlBackgroundBrushEmphasizedAccent}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- ===== Topbar (mockup .topbar) =====
             Title 20px/660 with a 12.5px muted line under it; the actions sit at the
             right edge of the same strip. -->
        <Style Selector="TextBlock.toptitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="660" />
            <Setter Property="LetterSpacing" Value="-0.2" />
        </Style>
        <Style Selector="TextBlock.topsub">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="Opacity" Value="{DynamicResource VdfTextMutedOpacity}" />
        </Style>
        <!-- Topbar actions (mockup .btn-ghost.btn-sm): the outlined small button. Plain
             text links used to float over the page here; the mockup gives secondary
             commands a border so they do not read as part of the title. -->
        <Style Selector="Button.navlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="550" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
        </Style>
        <Style Selector="Button.navlink:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource VdfVerdictBorderBrush}" />
        </Style>
        <!-- ===== Sidebar rail (mockup .rail): brand block on top, nav items below.
             The window moves from a single scanner pane to "rail + content", which is
             the shell the user signed off on in the HTML mockup. ===== -->
        <!-- Mockup .nav-item: 9px 12px, radius 11, 13.5px, 10px between icon and label.
             The 1px transparent border is what the active state lights up as the
             mockup's inset ring; without it the item would shift by a pixel when
             it becomes the current one. -->
        <Style Selector="Button.railitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="500" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{DynamicResource VdfTextDim80Opacity}" />
        </Style>
        <Style Selector="Button.railitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
        </Style>
        <Style Selector="Button.railitem:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The item of the view currently shown: the mockup's accent-soft fill, and the
             accent ink for the label. The mockup also draws an inset accent ring here; the
             user read that ring as a border around the selection and asked for it gone, so
             the fill carries the state on its own (the thickness stays at 1 so the item
             does not shift by a pixel when it becomes current). -->
        <Style Selector="Button.railitem.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.railitem.active">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VdfAccentTextBrush}" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.railitem Path">
            <Setter Property="Stroke" Value="{DynamicResource VdfAccentTextBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <!-- Mockup .nav-label: 11px, 600, wide tracking, and the section's own 10px
             gap above it (mockup .nav-group). -->
        <Style Selector="TextBlock.railgroup">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Margin" Value="12,10,0,6" />
            <Setter Property="Opacity" Value="{DynamicResource VdfTextMutedOpacity}" />
        </Style>
        <!-- Brand block: the whole block is the collapse toggle (mockup .brand),
             padding 6px 10px 18px with an 11px gap to the wordmark. -->
        <Style Selector="Button.railbrand">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,6,10,18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.railbrand:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
        </Style>
        <!-- Settings children: indented, one size down (mockup .nav-sub-item). The 22px
             left padding is where the mockup's ::before dot sits; the 14px gap after it
             lands the label on the mockup's 40px. -->
        <Style Selector="Button.railsub">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="22,7,10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{DynamicResource VdfTextDim80Opacity}" />
        </Style>
        <Style Selector="Button.railsub:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
        </Style>
        <Style Selector="Button.railsub:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The section that is showing (mockup .nav-sub-item.active): the same soft accent
             the rail's own entries light up with, and the dot takes the accent colour. -->
        <Style Selector="Button.railsub.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.railsub.active">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource VdfAccentTextBrush}" />
        </Style>
        <Style Selector="Button.railsub.active Border.railsubdot">
            <Setter Property="Background" Value="{DynamicResource VdfAccentTextBrush}" />
        </Style>
        <!-- Mockup .nav-sub-item::before: the 4px dot that marks these as children of
             "设置" rather than top-level entries. -->
        <Style Selector="Border.railsubdot">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource VdfMutedBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The caret of the expandable "Settings" entry turns to point down while open. -->
        <Style Selector="Button.railitem Path.caret">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="Button.railitem.expanded Path.caret">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <!-- Theme segment (mockup .seg): a sunken track holding two halves, and the
             chosen half is the raised card — not an accent pill, which is what the
             mockup's .seg button.on shows. -->
        <Style Selector="Button.railseg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <!-- The track is a UniformGrid now (so the two halves can stack when the rail
                 collapses); the 3px gutter the Grid used to take comes from these margins. -->
            <Setter Property="Margin" Value="1.5,0" />
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{DynamicResource VdfTextDim80Opacity}" />
        </Style>
        <Style Selector="Button.railseg Path">
            <Setter Property="Stroke" Value="{DynamicResource VdfAccentTextBrush}" />
        </Style>
        <Style Selector="Button.railseg.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfCardBrush}" />
        </Style>
        <Style Selector="Button.railseg.on">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.railseg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
        </Style>
        <Style Selector="Button.railseg:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 主题切换轨道：默认并排两格（浅色 | 深色）。Rows/Columns 是在这里用样式给的，
             不是写在控件上——写在控件上就是本地值，折叠态那条规则压不过它，竖排会失效。 -->
        <Style Selector="UniformGrid#RailThemeSeg">
            <Setter Property="Rows" Value="1" />
            <Setter Property="Columns" Value="2" />
        </Style>

        <!-- ===== 折叠后的侧栏（mockup .app.rail-min）=====
             原型在这一档只留图标：导航项居中、分组标题与设置子项收起、计数徽标也收起
             （.nav-item .dot{display:none}），底部的浅色/深色从并排两格翻成上下两格。
             这些规则都挂在根节点 Border.railmin 下面，展开时一条都不生效。 -->
        <Style Selector="Border.railmin Button.railitem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
        <!-- 两个用 DockPanel 的条目（查重结果/设置）自己写死了 HorizontalContentAlignment=Stretch，
             样式压不过本地值，所以改成把内容块本身居中。 -->
        <Style Selector="Border.railmin Button.railitem StackPanel, Border.railmin Button.railitem DockPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.railmin Button.railbrand StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.railmin Button.railbrand">
            <Setter Property="Padding" Value="0,6,0,16" />
        </Style>
        <Style Selector="Border.railmin UniformGrid#RailThemeSeg">
            <Setter Property="Rows" Value="2" />
            <Setter Property="Columns" Value="1" />
        </Style>
        <Style Selector="Border.railmin Button.railseg">
            <Setter Property="Margin" Value="0,1.5" />
        </Style>

        <!-- 主题的按钮模板会给内容文字加下划线（原型里没有这回事）。品牌块和侧栏导航都不是
             超链接，把装饰去掉。模板值优先于无条件样式（见 _Accessibility.xaml 的同类说明），
             所以这里带一个恒真的 :not() 条件；真正的超链接 Button.hyperlink 走自己的模板
             （那套模板本来就把 Underline 写在里面），不受影响。 -->
        <Style Selector="Button.railbrand:not(.vdf-never) /template/ TextBlock, Button.railitem:not(.vdf-never) TextBlock, Button.railseg:not(.vdf-never) TextBlock">
            <!-- 空的集合 = 没有装饰。字符串 "None" 不是合法的装饰写法（解析器只认
                 Underline/Strikethrough/Overline/Baseline）。 -->
            <Setter Property="TextDecorations">
                <TextDecorationCollection />
            </Setter>
        </Style>
    </Window.Styles>
    <!-- Wraps everything, so that it is an ancestor of whatever has keyboard focus: the one
         place a screen reader is sure to hear an announcement from (see AnnouncerHost). -->
    <ctl:AnnouncerHost x:Name="Announcer">
    <!-- The window's own edge, in the palette's hairline rather than the theme's chrome
         grey: a neutral grey frame around a blue-tinted dark UI reads as a leftover. -->
    <Border BorderBrush="{DynamicResource VdfCardLineBrush}" BorderThickness="2">
        <Grid>
            <controls:ExperimentalAcrylicBorder
                x:Name="ExperimentalAcrylicBorderBackgroundWhite"
                IsHitTestVisible="False"
                IsVisible="False">
                <controls:ExperimentalAcrylicBorder.Material>
                    <media:ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="White" />
                </controls:ExperimentalAcrylicBorder.Material>
            </controls:ExperimentalAcrylicBorder>
            <controls:ExperimentalAcrylicBorder
                x:Name="ExperimentalAcrylicBorderBackgroundBlack"
                IsHitTestVisible="False"
                IsVisible="False">
                <controls:ExperimentalAcrylicBorder.Material>
                    <media:ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="Black" />
                </controls:ExperimentalAcrylicBorder.Material>
            </controls:ExperimentalAcrylicBorder>
            <TextBlock
                x:Name="TextBlockWindowTitle"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                IsHitTestVisible="false"
                Text="{Binding #MainWindow.Title}" />
            <Grid
                x:Name="MainContentGrid"
                Margin="2,30,2,2"
                ColumnDefinitions="Auto,*">
                <!-- ============ 侧边栏 (mockup .rail) ============ -->
                <!-- Sidebar rail: 216px wide (74px collapsed), padding 18px 12px 14px. -->
                <Border
                    Grid.Column="0"
                    Classes.railmin="{Binding IsRailCollapsed}"
                    Width="{Binding RailColumnWidth}"
                    Padding="12,18,12,14"
                    Background="{DynamicResource VdfRailBrush}"
                    BorderBrush="{DynamicResource VdfCardLineBrush}"
                    BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">

                        <!-- 品牌区：整块可点击，折叠 / 展开侧边栏（mockup .brand） -->
                        <Button
                            Classes="railbrand"
                            Command="{Binding ToggleRailCommand}"
                            DockPanel.Dock="Top"
                            ToolTip.Tip="{Binding RailToggleTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <!-- Mockup .brand-mark: 38x38, radius 12, the accent
                                     gradient with its white inner ring. -->
                                <Border
                                    Width="38"
                                    Height="38"
                                    CornerRadius="12"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    Background="{DynamicResource VdfBrandMarkBrush}">
                                    <Path
                                    Stretch="Uniform"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M6 3h7a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3z M8 21h10a3 3 0 0 0 3-3V8"
                                        Fill="Transparent"
                                        Stroke="{DynamicResource VdfBrandMarkInkBrush}"
                                        StrokeLineCap="Round"
                                        StrokeJoin="Round"
                                        StrokeThickness="1.9" />
                                </Border>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowRailLabels}">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="650"
                                        Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Brand]}"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="11.5"
                                        Opacity="{DynamicResource VdfTextMutedOpacity}"
                                        Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.BrandSub]}"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Mockup .rail-foot: the theme segment at the bottom of the
                             rail, on the mockup's sunken track (margin 10px 4px 4px,
                             padding 3px, radius 11). -->
                        <Border
                            DockPanel.Dock="Bottom"
                            Margin="0,6,0,0"
                            Padding="0,12,0,0"
                            BorderBrush="{DynamicResource VdfCardLineBrush}"
                            BorderThickness="0,1,0,0">
                            <Border
                                Margin="4,10,4,4"
                                Padding="3"
                                Background="{DynamicResource VdfSunkenBrush}"
                                CornerRadius="11">
                                <UniformGrid
                                    x:Name="RailThemeSeg">
                                    <Button
                                        Grid.Column="0"
                                        Classes="railseg"
                                        Classes.on="{Binding IsLightTheme}"
                                        AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Theme.Light]}"
                                        Command="{Binding SetThemeModeCommand}"
                                        CommandParameter="Light"
                                        ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Theme.Light]}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <Path
                                            Stretch="Uniform"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                                                Fill="Transparent"
                                                StrokeLineCap="Round"
                                                StrokeThickness="1.7" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowRailLabels}"
                                                Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Theme.Light]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Classes="railseg"
                                        Classes.on="{Binding IsDarkTheme}"
                                        AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Theme.Dark]}"
                                        Command="{Binding SetThemeModeCommand}"
                                        CommandParameter="Dark"
                                        ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Theme.Dark]}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <Path
                                            Stretch="Uniform"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Data="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z"
                                                Fill="Transparent"
                                                StrokeLineCap="Round"
                                                StrokeJoin="Round"
                                                StrokeThickness="1.7" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowRailLabels}"
                                                Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Theme.Dark]}" />
                                            </StackPanel>
                                        </Button>
                                </UniformGrid>
                            </Border>
                        </Border>

                        <!-- 导航项（mockup .nav-group）：分组标题 + 条目；折叠后只留图标 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0" Spacing="0">

                                <TextBlock
                                    Classes="railgroup"
                                    IsVisible="{Binding ShowRailLabels}"
                                    Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Group.Scan]}" />

                                <!-- 扫描设置 -->
                                <Button
                                    Classes="railitem"
                                    Classes.active="{Binding IsRailScanSetupActive}"
                                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.ScanSettings]}"
                                    Command="{Binding ShowRailScanSetupCommand}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.ScanSettings]}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path
                                        Stretch="Uniform"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M16 16L20 20"
                                            Fill="Transparent"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.9" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowRailLabels}"
                                            Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.ScanSettings]}" />
                                    </StackPanel>
                                </Button>

                                <!-- 查重结果（组数徽标） -->
                                <Button
                                    Classes="railitem"
                                    Classes.active="{Binding IsRailResultsActive}"
                                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Results]}"
                                    Command="{Binding ShowRailResultsCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Results]}">
                                    <DockPanel>
                                        <Path
                                        Stretch="Uniform"
                                            DockPanel.Dock="Left"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="M5 4h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM5 14h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2z"
                                            Fill="Transparent"
                                            StrokeLineCap="Round"
                                            StrokeJoin="Round"
                                            StrokeThickness="1.7" />
                                        <Border
                                            DockPanel.Dock="Right"
                                            MinWidth="22"
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource VdfAccentSolidBrush}"
                                            CornerRadius="99"
                                            IsVisible="{Binding ShowRailCountBadge}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource VdfOnAccentSolidBrush}"
                                                Text="{Binding Duplicates.Count}" />
                                        </Border>
                                        <TextBlock
                                            Margin="10,0,6,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowRailLabels}"
                                            Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Results]}" />
                                    </DockPanel>
                                </Button>

                                <TextBlock
                                    Classes="railgroup"
                                    IsVisible="{Binding ShowRailLabels}"
                                    Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Group.Manage]}" />

                                <!-- 扫描目录 -->
                                <Button
                                    Classes="railitem"
                                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Folders]}"
                                    Command="{Binding ShowRailScannerCommand}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Folders]}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path
                                        Stretch="Uniform"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="M3 7a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"
                                            Fill="Transparent"
                                            StrokeLineCap="Round"
                                            StrokeJoin="Round"
                                            StrokeThickness="1.7" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowRailLabels}"
                                            Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Folders]}" />
                                    </StackPanel>
                                </Button>

                                <!-- 忽略名单 -->
                                <Button
                                    Classes="railitem"
                                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Blacklist]}"
                                    Command="{Binding OpenBlacklistManagerCommand}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Blacklist]}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path
                                        Stretch="Uniform"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0M6 6l12 12"
                                            Fill="Transparent"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.7" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowRailLabels}"
                                            Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Blacklist]}" />
                                    </StackPanel>
                                </Button>

                                <!-- 设置：点开列出分区（mockup .nav-parent）。分区列表就住在
                                     这里——页内不再另开一栏，否则同一份列表会出现两次。 -->
                                <Button
                                    Classes="railitem"
                                    Classes.active="{Binding IsShellSettingsVisible}"
                                    Classes.expanded="{Binding IsRailSettingsExpanded}"
                                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Settings]}"
                                    Command="{Binding ToggleRailSettingsCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Settings]}">
                                    <DockPanel>
                                        <Path
                                        Stretch="Uniform"
                                            DockPanel.Dock="Left"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M12 3v2.4M12 18.6V21M21 12h-2.4M5.4 12H3M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7M18.4 18.4l-1.7-1.7M7.3 7.3L5.6 5.6"
                                            Fill="Transparent"
                                            StrokeLineCap="Round"
                                            StrokeThickness="1.7" />
                                        <Path
                                        Stretch="Uniform"
                                            Classes="caret"
                                            DockPanel.Dock="Right"
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            Data="M9 6l6 6-6 6"
                                            Fill="Transparent"
                                            IsVisible="{Binding ShowRailLabels}"
                                            StrokeLineCap="Round"
                                            StrokeJoin="Round"
                                            StrokeThickness="2.4" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowRailLabels}"
                                            Text="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Settings]}" />
                                    </DockPanel>
                                </Button>

                                <!-- 设置子项：与设置页分区一一对应（mockup .nav-sub-item） -->
                                <StackPanel IsVisible="{Binding ShowRailSettingsChildren}" Spacing="1">
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Scanning}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Settings.Scanning]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="Scanning">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Settings.Scanning]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Matching}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Nav.Matching]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="Matching">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Nav.Matching]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PartialClips}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Nav.PartialClips]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="PartialClips">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Nav.PartialClips]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Files}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Nav.FilesFilters]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="Files">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Nav.FilesFilters]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Database}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Sub.Results]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="Database">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Settings.Sub.Results]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Processing}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Settings.Processing]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="Processing">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Settings.Processing]}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="railsub"
                                            Classes.active="{Binding SettingsSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Appearance}"
                                            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Settings.Appearance]}"
                                            Command="{Binding ShowSettingsSectionCommand}" CommandParameter="Appearance">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Classes="railsubdot" />
                                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Settings.Appearance]}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                                <!-- ===== 主区（mockup .main）：顶栏 + 页面 ===== -->
                <!-- The page sits on the mockup's page-bg token so the cards on top of it
                     read as cards; the rail keeps its own lighter surface at the side. -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*"
                      Background="{DynamicResource VdfPageBrush}">
                    <!-- Mockup .topbar: 86px tall, padding 20px 32px 14px, the title and
                         its sub-line on the left and the actions at the right edge. -->
                    <Border Grid.Row="0" Height="86" Padding="32,20,32,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Classes="toptitle" Text="{Binding TopbarTitle}" />
                                <TextBlock Classes="topsub" Text="{Binding TopbarSub}" />
                            </StackPanel>
                            <StackPanel
                                x:Name="TitlebarNav"
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="9">
<Button
                    Classes="navlink"
                    Command="{Binding NewScanCommand}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Shell.NewScan]}"
                    IsVisible="{Binding ShowNavNewScan}" />
                <Button
                    Classes="navlink"
                    Command="{Binding ShowShellViewCommand}"
                    CommandParameter="Main"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Shell.BackToResults]}"
                    IsVisible="{Binding ShowNavBackToResults}" />
                <!-- Log / Settings moved into the sidebar rail: keeping them here as well
                     duplicated the navigation. "New scan" and "Back to results" stay —
                     they are workflow links, not top-level navigation. -->
                <!-- ⋯ overflow (stage 7): home of everything stateless — database
                     maintenance, blacklist, About — plus a contextual scan-results
                     section in the Review state. Replaces the legacy menu bar. -->
                <Button
                    Classes="navlink"
                    FontWeight="Bold"
                    Content="⋯"
                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Shell.MoreMenu]}"
                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Shell.MoreMenu]}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <!-- Scan results (Review only) -->
                            <MenuItem
                                Command="{Binding StartScanCommand}"
                                CommandParameter="CompareOnly"
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Command.Rescan]}"
                                ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Tooltip.Rescan]}"
                                IsEnabled="{Binding IsReadyToCompare}"
                                IsVisible="{Binding IsReviewState}" />
                            <MenuItem
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ExportScanResults]}"
                                IsVisible="{Binding !!Duplicates.Count}">
                                <MenuItem
                                    Command="{Binding ExportScanResultsCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ExportScanResults.Json]}" />
                                <MenuItem
                                    Command="{Binding ExportScanResultsPrettyCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ExportScanResults.JsonPretty]}" />
                                <MenuItem
                                    Command="{Binding ExportScanResultsToFileCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ExportScanResults.WithThumbnails]}" />
                                <MenuItem
                                    Command="{Binding ExportScanResultsToCsvCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ExportScanResults.Csv]}" />
                            </MenuItem>
                            <MenuItem
                                Command="{Binding ImportScanResultsFromFileCommand}"
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ImportScanResults]}"
                                IsEnabled="{Binding !IsScanning}" />
                            <Separator />
                            <!-- Database maintenance: disabled while a scan runs (same rule the
                                 old menu enforced by hiding the submenu) -->
                            <MenuItem
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.Database]}"
                                IsEnabled="{Binding !IsScanning}">
                                <MenuItem
                                    Command="{Binding CleanDatabaseCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.Cleanup]}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Tooltip.CleanDatabase]}" />
                                <MenuItem
                                    Command="{Binding PruneGhostEntriesCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.PruneGhostEntries]}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Tooltip.PruneGhostEntries]}" />
                                <MenuItem
                                    Command="{Binding EditDataBaseCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.EditEllipsis]}" />
                                <MenuItem
                                    Command="{Binding RelocateDatabaseFilesCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.RelocateFiles]}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding ExportDataBaseToJsonCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.ExportJson]}" />
                                <MenuItem
                                    Command="{Binding ExportDataBaseToJsonPrettyCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.ExportJsonPretty]}" />
                                <MenuItem
                                    Command="{Binding ImportDataBaseFromJsonCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.ImportJson]}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding ClearDatabaseCommand}"
                                    Foreground="{DynamicResource VdfDangerBrush}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Database.Clear]}" />
                            </MenuItem>
                            <MenuItem
                                Command="{Binding OpenBlacklistManagerCommand}"
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.ManageBlacklist]}" />
                            <!-- The checked-items actions, moved out of the results dock: the
                                 dock's own row was wider than the list at this window width and
                                 the theme clipped its right end. Here they have room, and this
                                 menu is already where the infrequent commands live. Visible only
                                 while something is checked - "checked" is what they act on. -->
                            <Separator IsVisible="{Binding !!DuplicatesCheckedCounter}" />
                            <MenuItem
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[Results.Dock.CheckedItemsHeading]}"
                                IsVisible="{Binding !!DuplicatesCheckedCounter}">
                                <MenuItem
                                    Command="{Binding RemoveCheckedItemsFromListCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListOnly]}" />
                                <MenuItem
                                    Command="{Binding RemoveCheckedItemsFromListAndBlacklistCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListAndExclude]}" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding CreateSymbolLinksForCheckedItemsCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListAndSymbolLinks]}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.SymbolLinkTooltip]}" />
                                <MenuItem
                                    Command="{Binding CreateSymbolLinksForCheckedItemsAndBlacklistCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListSymbolLinksExclude]}" />
                                <MenuItem
                                    Command="{Binding CreateHardLinksForCheckedItemsCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListAndHardLinks]}"
                                    ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.HardLinkTooltip]}" />
                                <MenuItem
                                    Command="{Binding CreateHardLinksForCheckedItemsAndBlacklistCommand}"
                                    Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.RemoveFromListHardLinksExclude]}" />
                            </MenuItem>
                            <!-- Log left the rail: the mockup's rail is scan + manage +
                                 settings, so the log lives with the other stateless
                                 entries here. -->
                            <MenuItem
                                Command="{Binding ShowShellViewCommand}"
                                CommandParameter="Log"
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[Rail.Log]}" />
                            <Separator />
                            <MenuItem
                                Command="{Binding AboutCommand}"
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Menu.About]}" />
                            <MenuItem
                                Command="{Binding OpenOwnFolderCommand}"
                                Header="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.OpenFolder]}"
                                IsVisible="{Binding IsDebug}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid IsVisible="{Binding IsShellMainVisible}">
                        <Grid>
                            <!-- Disabled while the busy curtain covers it: the curtain alone only
                                 stops the mouse, Tab walked straight into the views below and
                                 Space / Delete there acted in the middle of a running operation.
                                 Same condition as the curtain's IsVisible, inverted. -->
                            <Grid x:Name="BusyCoveredViews">
                                <Grid.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="!IsBusy" />
                                        <Binding Path="IsScanning" />
                                    </MultiBinding>
                                </Grid.IsEnabled>
                                <!-- One window, three states: Setup → Scanning → Review (stage 2).
                                     The legacy menu bar and stats row are gone (stage 7): stateless
                                     commands live in the titlebar ⋯ menu, selection tools in the
                                     Review toolbar, stats in the Review statusline. -->
                                <views:SetupView IsVisible="{Binding IsSetupState}" />
                                <views:ScanningView IsVisible="{Binding IsScanningState}" />
                                <views:DuplicateResultsView
                                    x:Name="NewResultsView"
                                    IsVisible="{Binding IsReviewState}" />
                            </Grid>
                            <Grid x:Name="BusyIndicator">
                                <!-- Scans render in the window center (Scanning state) — the busy
                                     curtain only covers non-scan operations (delete, import, …). -->
                                <Grid.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsBusy" />
                                        <Binding Path="!IsScanning" />
                                    </MultiBinding>
                                </Grid.IsVisible>
                                <!-- Curtain: fades the view underneath and swallows its input;
                                     kept as a sibling so the panel itself stays fully opaque. -->
                                <Border Background="{DynamicResource VdfPageBrush}" Opacity="{DynamicResource VdfTextDim85Opacity}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar
                                        Height="10"
                                        MaxWidth="200"
                                        BorderBrush="LimeGreen"
                                        BorderThickness="1"
                                        AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Busy.PleaseWait]}"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding BusyProgressPercent}">
                                        <ProgressBar.IsIndeterminate>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="IsBusy" />
                                                <Binding Path="BusyProgressIsIndeterminate" />
                                            </MultiBinding>
                                        </ProgressBar.IsIndeterminate>
                                    </ProgressBar>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="ExtraBold"
                                        Text="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Busy.PleaseWait]}" />
                                    <TextBlock
                                        Name="LblBusyIndicator"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Text="{Binding IsBusyOverlayText}" />
                                    <Button
                                        x:Name="BusyCancelButton"
                                        Margin="0,15,0,0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding CancelBusyCommand}"
                                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Cancel]}"
                                        IsVisible="{Binding IsBusyCancelable}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                </Grid>
                <views:SettingsView Grid.Row="1" IsVisible="{Binding IsShellSettingsVisible}" />
                <views:LogView Grid.Row="1" IsVisible="{Binding IsShellLogVisible}" />
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Border>
    </ctl:AnnouncerHost>

</Window>
