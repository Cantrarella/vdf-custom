<UserControl
    x:Class="VDF.GUI.Views.SetupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Settings="clr-namespace:VDF.GUI.Data;assembly=VDF.GUI"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:views="clr-namespace:VDF.GUI.Views;assembly=VDF.GUI"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels;assembly=VDF.GUI"
    x:DataType="vm:MainWindowVM">

  <UserControl.Resources>
    <!-- 0.42 is the mockup's .dir-row.off, not a round number: it has to leave the
         path readable so a switched-off folder can still be found and turned back on. -->
    <mvvm:BoolToValueConverter x:Key="DisabledOpacityConverter" TrueValue="0.42" FalseValue="1.0" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Mockup .scanbar: the estimate on the left, the CTA on the right. It stays put
         while the cards below scroll, so starting a scan never needs scrolling. -->
    <Style Selector="Border.scanbar">
      <Setter Property="Background" Value="{DynamicResource VdfCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="20,15" />
      <!-- The same elevation the option cards below it carry: the bar is a card too. -->
      <Setter Property="BoxShadow" Value="{DynamicResource VdfCardShadow}" />
    </Style>
    <!-- Mockup .dir-row: one include folder. Rows are separated by hairlines and the
         whole row dims while the folder is switched off. -->
    <Style Selector="Border.dirrow">
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="20,12" />
    </Style>
    <!-- Mockup .dir-ico: 34x34, radius 10, accent-soft ground. The icon inside it carries
         the accent ink itself - see the folder path in the item template. -->
    <Style Selector="Border.drivechip">
      <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Mockup .btn-sm: 6px 11px, 12.5px, radius 9. .soft is the folder card's own
         "添加目录" (mockup .btn-soft). -->
    <Style Selector="Button.dirbtn">
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.dirbtn.soft">
      <Setter Property="Background" Value="{DynamicResource VdfSunkenBrush}" />
    </Style>
    <Style Selector="Border.offchip">
      <Setter Property="Background" Value="{DynamicResource VdfMutedSoftBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
    </Style>
    <!-- The scan button's three states. It wears a SOLID fill now (see App.xaml), so the
         palette has to supply every state: without these two, hovering falls back to the
         theme's own accent and the button changes colour family under the pointer.
         .solid only pins the presenter to the button's own Background; it does not invent
         hover or pressed tints. (The previous rule here pinned the PRESSED presenter to the
         palette's row-hover grey: that was for the soft fill, where the theme painted over
         the pale tint and left the label 4.43:1.) -->
    <Style Selector="Button#ScanButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource VdfPrimarySolidHoverBrush}" />
    </Style>
    <Style Selector="Button#ScanButton:pressed">
      <Setter Property="Background" Value="{DynamicResource VdfPrimarySolidPressedBrush}" />
    </Style>
    <Style Selector="Border.offchip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <!-- Mockup page 1: scan bar, then one card per group of options in a single column.
       The two-column split it replaces put folders and options side by side, which is
       not what the approved mockup shows. -->
  <!-- Mockup .wrap: 32px gutters and the 1080px measure, the same numbers the results
       page uses. The cards used to sit 24px in, which is 8px narrower than the page the
       mockup drew and put this page's edges out of line with every other one. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,2,32,0" MaxWidth="1080">

    <!-- "no duplicates found": shown after a completed scan that matched nothing, so
         returning to this screen is distinguishable from the never-scanned state -->
    <Border
        Grid.Row="0"
        CornerRadius="8"
        Padding="12,8"
        Margin="0,14,0,0"
        Background="{DynamicResource VdfGoodSoftBrush}"
        BorderBrush="{DynamicResource VdfGoodBorderBrush}"
        BorderThickness="1"
        IsVisible="{Binding ShowNoDuplicatesNotice}">
      <DockPanel LastChildFill="True">
        <Button
            DockPanel.Dock="Right"
            Background="Transparent"
            BorderThickness="0"
            FontSize="12"
            Opacity="{DynamicResource VdfTextDim85Opacity}"
            VerticalAlignment="Center"
            Command="{Binding DismissNoDuplicatesNoticeCommand}"
            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Close]}"
            ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Close]}"
            Content="✕" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock FontSize="14" VerticalAlignment="Center"
                     Foreground="{DynamicResource VdfGoodBrush}"
                     Text="✓" />
          <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.NoDuplicates.Title]}" />
          <TextBlock FontSize="13" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.NoDuplicates.Text]}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== scan bar ===== -->
    <Border Grid.Row="1" Classes="scanbar" Margin="0,14,0,0">
      <DockPanel LastChildFill="True">
        <StackPanel
            DockPanel.Dock="Right"
            Orientation="Horizontal"
            Spacing="12"
            VerticalAlignment="Center">
          <Button
              Classes="hyperlink"
              FontSize="12.5"
              VerticalAlignment="Center"
              Click="OnAdvancedSettingsClick"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Setup.AdvancedSettings]}" />
          <!-- The scan call to action (mockup .btn-primary): a SOLID primary fill with the
               mockup's own dark ink on it, and its own lift shadow. It used to be the soft
               accent surface with the accent ink, which read as another secondary button in
               a row of secondary buttons.

               The ink is the mockup's accent-btn-text token, not the palette doc's #FFFFFF:
               white on this blue is 2.55:1 and ContrastTests.Text_IsReadable measures this
               very button. See App.xaml for the three fills.
               Classes="solid" is what keeps the fill: without it the theme repaints the
               content presenter on hover and press, and the button goes grey under the
               pointer. The label and the glyph carry their own foreground because a theme
               may set one on the presenter and win over the button's. -->
          <!-- The mockup's primary lift. A Button carries no BoxShadow of its own, and in
               this theme's template the fill is painted by the CONTENT PRESENTER, not by a
               border one could shadow - so the lift is drawn by this wrapper, which takes
               the button's exact size and corner radius. Background is transparent rather
               than null, which is what makes Avalonia draw a shadow with nothing under it. -->
          <Border VerticalAlignment="Center"
                  CornerRadius="11"
                  Background="Transparent"
                  BoxShadow="0 2 10 -4 #E65AA9E6">
          <Button
              x:Name="ScanButton"
              Classes="solid"
              FontSize="13.5"
              FontWeight="620"
              Padding="16,9"
              CornerRadius="11"
              VerticalAlignment="Center"
              Background="{DynamicResource VdfPrimarySolidBrush}"
              Foreground="{DynamicResource VdfOnPrimarySolidBrush}"
              AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Setup.StartScan]}"
              Command="{Binding StartScanCommand}"
              CommandParameter="FullScan">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Stroke="{DynamicResource VdfOnPrimarySolidBrush}" StrokeThickness="2.2"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M 6 4 L 19 12 L 6 20 Z" />
              <TextBlock
                  Foreground="{DynamicResource VdfOnPrimarySolidBrush}"
                  Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.StartScan]}" />
            </StackPanel>
          </Button>
          </Border>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding SetupEstimatedFilesText}" />
          <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim70Opacity}" Text="{Binding SetupEstimatedHintText}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== the three option cards ===== -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,14,0,20">

        <!-- 扫描目录 -->
        <Border Classes="setcard">
          <StackPanel>
            <Border Classes="cardhead">
              <DockPanel LastChildFill="True">
                <!-- Mockup .btn-soft: the plus glyph leads the label, and takes the button's
                     own foreground so it follows every state the theme gives one, rather
                     than being pinned to a palette colour that then clashes with it. -->
                <Button
                    DockPanel.Dock="Right"
                    Classes="dirbtn soft"
                    VerticalAlignment="Center"
                    Command="{Binding AddIncludesToListCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                          StrokeLineCap="Round"
                          VerticalAlignment="Center"
                          Data="M12 5v14M5 12h14" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.AddDir]}" />
                  </StackPanel>
                </Button>
                <StackPanel Spacing="2">
                  <TextBlock Classes="cardtitle"
                             Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Folders.Title]}" />
                  <TextBlock Classes="carddesc"
                             Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Folders.Desc]}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding SetupFolders}"
                          AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Folders.Title]}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SetupFolderVM">
                  <!-- Excluded folders belong to the ignore list page; this card lists
                       what will actually be scanned. -->
                  <Border Classes="dirrow" IsVisible="{Binding !IsExcluded}"
                          Opacity="{Binding IsDisabled, Converter={StaticResource DisabledOpacityConverter}}">
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Left" Width="34" Height="34"
                              Classes="drivechip">
                        <!-- Mockup .dir-ico: the folder outline in the chip's accent ink. It
                             used to be the drive LETTER ("E:"), which told nobody anything
                             the path beside it does not say more plainly. -->
                        <Path Width="17" Height="17" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource VdfAccentTextBrush}" StrokeThickness="2"
                              StrokeJoin="Round" StrokeLineCap="Round"                              Data="M3 7a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
                      </Border>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button
                            Classes="dirbtn"
                            IsVisible="{Binding ShowCountNow}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).CountFolderNowCommand}"
                            CommandParameter="{Binding}"
                            Content="{Binding Source={x:Static local:App.Lang}, Path=[Setup.CountNow]}" />
                        <Button
                            Classes="dirbtn"
                            IsVisible="{Binding !IsDisabled}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleSetupFolderCommand}"
                            CommandParameter="{Binding}"
                            Content="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Disable]}" />
                        <Button
                            Classes="dirbtn"
                            IsVisible="{Binding IsDisabled}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleSetupFolderCommand}"
                            CommandParameter="{Binding}"
                            Content="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Enable]}" />
                        <!-- Mockup: the frame takes its danger-line token, the TEXT stays the
                             danger ink.
                             One strong colour for both made a quiet row-level action look
                             like a warning; split, it reads as a button you may still
                             press. High contrast keeps one red for both - see App.xaml. -->
                        <Button
                            Classes="dirbtn"
                            Foreground="{DynamicResource VdfDangerBrush}"
                            BorderBrush="{DynamicResource VdfDangerLineBrush}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).RemoveSetupFolderCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Setup.RemoveFolder]}"
                            Content="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Remove]}" />
                      </StackPanel>
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <!-- Monospace, as in the mockup: paths are compared character by
                             character, and a proportional face hides where two of them
                             stop matching. -->
                        <TextBlock FontSize="13" FontWeight="550"
                                   FontFamily="Consolas, 'Cascadia Mono', 'Courier New', monospace"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ProgressBar Width="40" Height="4" IsIndeterminate="True"
                                       IsVisible="{Binding IsCounting}" VerticalAlignment="Center" />
                          <TextBlock FontSize="11.5" Opacity="{DynamicResource VdfTextMutedOpacity}" Text="{Binding MetaText}" />
                          <Border Classes="offchip" VerticalAlignment="Center" IsVisible="{Binding IsDisabled}">
                            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.DisabledChip]}" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- dashed drop zone (drop handled view-wide; Alt = exclude) -->
            <Grid Margin="16,12,16,12" MinHeight="54">
              <Rectangle
                  Stroke="{DynamicResource VdfMutedBorderBrush}"
                  StrokeThickness="1.5"
                  StrokeDashArray="4,3"
                  RadiusX="8" RadiusY="8"
                  Fill="Transparent" />
              <StackPanel Orientation="Horizontal" Spacing="4"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="14,10">
                <TextBlock FontSize="13" Opacity="{DynamicResource VdfTextDim85Opacity}" FontWeight="SemiBold"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Drop.Bold]}" />
                <TextBlock FontSize="13" Opacity="{DynamicResource VdfTextFaintOpacity}"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Drop.Text]}" />
                <Button Classes="hyperlink" FontSize="13" VerticalAlignment="Center"
                        Command="{Binding AddIncludesToListCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Drop.Browse]}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 比对范围 -->
        <Border Classes="setcard">
          <StackPanel>
            <Border Classes="cardhead">
              <TextBlock Classes="cardtitle"
                         Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Scope.Title]}" />
            </Border>

            <views:SettingRow
                Title="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Scope.Image.Title]}"
                Description="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Scope.Image.Desc]}">
              <ToggleSwitch Classes="plain" VerticalAlignment="Center"
                            IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=IncludeImages}" />
            </views:SettingRow>

            <views:SettingRow ShowSeparator="False"
                Description="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Scope.MinSize.Desc]}">
              <views:SettingRow.Title>
                <MultiBinding StringFormat="{}{0} {1} {2}">
                  <Binding Source="{x:Static local:App.Lang}" Path="[Setup.Scope.MinSize.Pre]" />
                  <Binding Source="{x:Static Settings:SettingsFile.Instance}" Path="MinimumFileSize" />
                  <Binding Source="{x:Static local:App.Lang}" Path="[Setup.Scope.MinSize.Post]" />
                </MultiBinding>
              </views:SettingRow.Title>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <NumericUpDown Classes="stepper" Increment="1" Minimum="0" Maximum="999999" Width="90"
                               IsEnabled="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=FilterByFileSize}"
                               Value="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=MinimumFileSize}" />
                <TextBlock VerticalAlignment="Center" FontSize="12.5"
                           Opacity="{DynamicResource VdfTextDim80Opacity}" Text="MB" />
                <ToggleSwitch Classes="plain" VerticalAlignment="Center"
                              IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=FilterByFileSize}" />
              </StackPanel>
            </views:SettingRow>
          </StackPanel>
        </Border>

        <!-- 匹配强度 -->
        <Border Classes="setcard">
          <StackPanel>
            <Border Classes="cardhead">
              <StackPanel Spacing="2">
                <TextBlock Classes="cardtitle"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Title]}" />
                <TextBlock Classes="carddesc"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Desc]}" />
              </StackPanel>
            </Border>

            <!-- The profile picker: the mockup has no row for it, but dropping it would
                 leave no way to pick a profile anywhere, so it lives here as one row. -->
            <views:SettingRow
                Title="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Profile.Title]}"
                Description="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Profile.Desc]}">
              <ComboBox MinWidth="200" VerticalAlignment="Center"
                        ItemsSource="{Binding ScanProfileOptions}"
                        SelectedItem="{Binding ActiveScanProfileOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScanProfileOptionVM">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </views:SettingRow>

            <!-- mockup .slider-box -->
            <StackPanel Margin="20,18,20,10" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" LetterSpacing="-0.6"
                           Foreground="{DynamicResource VdfAccentTextBrush}"
                           Text="{Binding SimilarityThreshold, StringFormat=\{0:0.#\}}" />
                <TextBlock FontSize="13" VerticalAlignment="Center"
                           Opacity="{DynamicResource VdfTextDim70Opacity}"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Threshold]}" />
              </StackPanel>
              <Slider Classes="mock" Margin="0,16,0,10" Minimum="70" Maximum="100" TickFrequency="0.5"
                      IsSnapToTickEnabled="True" Value="{Binding SimilarityThreshold}" />
              <Grid ColumnDefinitions="*,*,*">
                <TextBlock Grid.Column="0" FontSize="11" HorizontalAlignment="Left"
                           Opacity="{DynamicResource VdfTextFaintOpacity}"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Scale.Loose]}" />
                <TextBlock Grid.Column="1" FontSize="11" HorizontalAlignment="Center"
                           Opacity="{DynamicResource VdfTextFaintOpacity}"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Scale.Standard]}" />
                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right"
                           Opacity="{DynamicResource VdfTextFaintOpacity}"
                           Text="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Scale.Strict]}" />
              </Grid>
            </StackPanel>

            <views:SettingRow
                Title="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Ai.Title]}"
                Description="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Ai.Desc]}">
              <ToggleSwitch Classes="plain" VerticalAlignment="Center"
                            IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=UseAiMatching}" />
            </views:SettingRow>

            <views:SettingRow
                Title="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Clip.Title]}"
                Description="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Clip.Desc]}">
              <ToggleSwitch Classes="plain" VerticalAlignment="Center"
                            IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=EnablePartialClipDetection}" />
            </views:SettingRow>

            <views:SettingRow ShowSeparator="False"
                Title="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Skip.Title]}"
                Description="{Binding Source={x:Static local:App.Lang}, Path=[Setup.Strength.Skip.Desc]}">
              <ToggleSwitch Classes="plain" VerticalAlignment="Center"
                            IsChecked="{Binding Source={x:Static Settings:SettingsFile.Instance}, Path=HideConfirmedGroups}" />
            </views:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- window-wide status line -->
    <Border Grid.Row="3"
            Padding="32,6"
            BorderBrush="{DynamicResource VdfCardLineBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextFaintOpacity}" Text="{Binding DatabaseInfoText}" />
    </Border>
  </Grid>
</UserControl>
