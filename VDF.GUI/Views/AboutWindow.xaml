<Window
    x:Class="VDF.GUI.Views.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520"
    CanResize="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None">
    <!-- The card, the page tint and the buttons come from Styles/_Dialogs.xaml. The rule
         under the header is the palette's hairline now: it was the theme's chrome grey,
         which is a third colour next to the card's own edge. -->
    <Border Classes="dlgbody dlgframe"
            Margin="28"
            Background="{DynamicResource VdfCardBrush}">
        <StackPanel Spacing="16">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Image
                    Width="60"
                    Height="60"
                    VerticalAlignment="Center"
                    Source="/Assets/Linux/icon.png" />
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Video Duplicate Finder" />
                    <TextBlock
                        x:Name="VersionText"
                        FontSize="13"
                        Opacity="{DynamicResource VdfTextDim80Opacity}" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource VdfCardLineBrush}" />

            <TextBlock
                x:Name="EnvText"
                Classes="dlghint"
                FontSize="12"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="LicenseText"
                Classes="dlghint"
                FontSize="12"
                TextWrapping="Wrap" />

            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="ProjectPageButton" Classes="dlgghost" Margin="4" />
                <Button x:Name="LatestReleaseButton" Classes="dlgghost" Margin="4" />
                <Button x:Name="CopyButton" Classes="dlgghost" Margin="4" />
                <Button
                    x:Name="OkButton"
                    Classes="dlgprimary"
                    Margin="4"
                    Click="OnOk"
                    IsDefault="True" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
