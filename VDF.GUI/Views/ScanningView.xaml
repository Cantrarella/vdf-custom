<UserControl
    x:Class="VDF.GUI.Views.ScanningView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:data="clr-namespace:VDF.GUI.Data;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels;assembly=VDF.GUI"
    x:DataType="vm:MainWindowVM">

  <UserControl.Styles>
    <!-- mockup .metric: one of the three figures under the current file. surface-soft
         on the card, radius 16, padding 13px 15px. -->
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="{DynamicResource VdfMutedSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="15,13" />
    </Style>
    <Style Selector="TextBlock.metricval">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
      <Setter Property="Foreground" Value="{DynamicResource VdfTextBrush}" />
    </Style>
    <Style Selector="TextBlock.metriclbl">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Opacity" Value="{DynamicResource VdfTextMutedOpacity}" />
    </Style>
    <!-- mockup .now-file: the file being read, monospace because two paths are told
         apart character by character -->
    <Style Selector="Border.nowfile">
      <Setter Property="Background" Value="{DynamicResource VdfAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfVerdictBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.nowfile">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource VdfAccentTextBrush}" />
      <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis" />
    </Style>
    <!-- mockup .btn-ghost.btn-sm; the mockup's only red on this page is the word
         "取消扫描", which is a label in red ink rather than a red button. -->
    <Style Selector="Button.scanact">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource VdfMutedBrush}" />
    </Style>
    <Style Selector="Button.scanact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfRowHoverBrush}" />
    </Style>
    <!-- The mockup's .btn-ghost:hover lifts the label to the page's main ink, and the
         contrast suite needs it to: the muted ink it rests at is 4.39:1 on the hover
         surface, a hair under the 4.5 a 12.5px label needs. -->
    <Style Selector="Button.scanact:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VdfTextBrush}" />
    </Style>
    <!-- .btn-ghost.btn-sm.txt-del: two tones, not one. The label is the danger ink and
         the frame is the danger LINE, a much lighter red, so the button stays an offer
         rather than becoming a solid red one to be avoided. In the two contrast themes
         the same key holds the same colour as the ink on purpose: splitting them there
         would only spend contrast the page needs elsewhere. Nothing is set for the
         pointer here - the rule above already lifts ghost labels to the page ink, and a
         second rule pinning the ink back to red again outranked it, silently. -->
    <Style Selector="Button.scanact.stop">
      <Setter Property="Foreground" Value="{DynamicResource VdfDangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfDangerLineBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Mockup page 3: one card holding the run's header row, its bar and its own
       numbers, with the reassurance line across the foot. Width follows the mockup's
       .wrap (32px gutters, 1080px measure) instead of the narrower 780px column this
       page used to centre itself in, which left the card floating in the middle of a
       wide page.
       The per-drive rows and the log tail live outside the card and stretch with the
       window, so long paths and remediation hints are not clipped to 1080px (#836). -->
  <Grid RowDefinitions="Auto,*">
    <Border
        Grid.Row="0"
        Classes="setcard"
        Margin="32,44,32,0"
        MaxWidth="1080">

      <StackPanel>
        <!-- ===== the run's own header row, then the bar. The bar is the upstream
                  page's own control - a 10px line, 5px corners, the card wide - and it
                  stands where a ring stood for one round of work: the ring needed a
                  full-circle geometry, a dash pattern measured in multiples of its own
                  stroke, and a converter to say "45%". A line says the same in one
                  control, and every reader already knows how to read it. ===== -->
        <StackPanel Margin="30,32">

          <!-- Title and stage on the left, count on the right, where the upstream page
               keeps its own count and estimate. -->
          <DockPanel LastChildFill="False" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
              <TextBlock FontSize="16" FontWeight="640" VerticalAlignment="Center"
                         Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Title]}" />
              <Border CornerRadius="10" Padding="10,2" VerticalAlignment="Center"
                      Background="{DynamicResource VdfMutedSoftBrush}"
                      IsVisible="{Binding ScanStageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock FontSize="11.5" FontWeight="SemiBold"
                           Opacity="{DynamicResource VdfTextMutedOpacity}"
                           Text="{Binding ScanStageText}" />
              </Border>
            </StackPanel>
            <!-- The estimate that used to sit beside the count is one of the cards
                 below now, so the percentage takes that half of the line. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock FontSize="12.5" Opacity="{DynamicResource VdfTextDim80Opacity}">
                <Run Text="{Binding ScanProgressCount, Mode=OneWay}" />
                <Run Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.FilesUnit]}" />
              </TextBlock>
              <TextBlock FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource VdfAccentTextBrush}"
                         Text="{Binding ScanProgressPercent, StringFormat=\{0\}%}" />
            </StackPanel>
          </DockPanel>

          <ProgressBar
              Height="10"
              CornerRadius="5"
              AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Title]}"
              Maximum="{Binding ScanProgressMaxValue, Mode=OneWay}"
              Value="{Binding ScanProgressValue, Mode=OneWay}" />

          <!-- The file being read, right under the bar as the upstream page had it,
               in the palette's own accent rather than a ring's centre. -->
          <Border Classes="nowfile" MaxWidth="560" Margin="0,10,0,0"
                  IsVisible="{Binding ScanCurrentFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="nowfile" Text="{Binding ScanCurrentFile}" />
          </Border>

          <StackPanel>
            <!-- mockup .metrics: three figures on the card's own soft surface.
                 The mockup's are "已发现重复组 / 预计可释放 / 文件 每秒"; the first two
                 are only known once the run is over, and printing the previous run's
                 figures during a new one is a lie, so this page shows the three things
                 a running scan actually knows: how long it has been going, how long it
                 expects to take, and how fast it is reading. -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,14,0,16">
              <Border Grid.Column="0" Classes="metric" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Classes="metricval" Text="{Binding TimeElapsed, Mode=OneWay}" />
                  <TextBlock Classes="metriclbl" Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Metric.Elapsed]}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Classes="metricval" Text="{Binding RemainingTime, Mode=OneWay}" />
                  <TextBlock Classes="metriclbl" Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Metric.Remaining]}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="metric">
                <StackPanel>
                  <!-- Nothing to show until a drive has been sampled twice: a rate needs
                       two readings, and the mockup's own figures are measured, not
                       guessed. -->
                  <TextBlock Classes="metricval" Text="{Binding ScanDrives.TotalRateText, TargetNullValue=—}" />
                  <TextBlock Classes="metriclbl" Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.FilesPerSec]}" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- mockup's two commands: pause / resume, and cancelling in red ink -->
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Button
                  Classes="scanact"
                  AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Pause]}"
                  Command="{Binding PauseScanCommand}"
                  IsVisible="{Binding !IsPaused}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <!-- Glyphs, not glyph fonts: pause used to be the character U+23F8 and
                       friends, which fall through to whatever font the system picks and
                       arrive in three different weights on three different machines.
                       These are the mockup's own shapes on its own 24-unit grid, filled
                       from the button's own Foreground so they follow its pointer state.
                       Stop is not in the mockup - it is this app's own command - so its
                       square borrows the same grid and the same 1-unit corners. -->
                  <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                        Fill="{Binding $parent[Button].Foreground}"
                        Data="M6 5h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M14 5h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" />
                  <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Pause]}" />
                </StackPanel>
              </Button>
              <Button
                  Classes="scanact"
                  AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Resume]}"
                  Command="{Binding ResumeScanCommand}"
                  IsVisible="{Binding IsPaused}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                        Fill="{Binding $parent[Button].Foreground}"
                        Data="M8 5l11 7-11 7z" />
                  <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Resume]}" />
                </StackPanel>
              </Button>
              <Button
                  Classes="scanact stop"
                  AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Stop]}"
                  Command="{Binding StopScanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                        Fill="{Binding $parent[Button].Foreground}"
                        Data="M7 6h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z" />
                  <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Stop]}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- mockup .note: the line across the card's foot -->
        <Border
            Padding="20,12"
            BorderBrush="{DynamicResource VdfCardLineBrush}"
            BorderThickness="0,1,0,0">
          <!-- mockup .note: a clock in front of the reassurance, in the same quiet ink
               the sentence itself is written in. A stroked outline rather than a solid
               glyph, so its weight stays put whatever font the reader's system has. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                  Stroke="{DynamicResource VdfTextBrush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Opacity="{DynamicResource VdfTextMutedOpacity}"
                  Data="M 12 3 A 9 9 0 0 1 12 21 A 9 9 0 0 1 12 3 M 12 7 V 12 L 15 14" />
            <TextBlock FontSize="12" VerticalAlignment="Center"
                       Opacity="{DynamicResource VdfTextMutedOpacity}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} {1} · {2}">
                  <Binding Source="{x:Static local:App.Lang}" Path="[Scan.Left]" />
                  <Binding Path="RemainingTime" />
                  <Binding Source="{x:Static local:App.Lang}" Path="[Scan.PauseNote]" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ===== below the card: per-drive rows, then the log tail ===== -->
    <Border Grid.Row="1" Margin="32,26,32,24" Padding="0,12,0,0"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource VdfCardLineBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel>
        <!-- per-drive rows (mockup .drives): label + type chip | byte-weighted bar |
             files stat. Present only while the analysis phase reports drive data;
             compare phases carry none. -->
        <ItemsControl
            Margin="0,0,0,14"
            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Scan.Drives]}"
            IsVisible="{Binding ScanDrives.HasRows}"
            ItemsSource="{Binding ScanDrives.Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="data:ScanDriveRow">
              <Grid ColumnDefinitions="200,*,150">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                             Text="{Binding Root}" />
                  <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                          BorderBrush="{DynamicResource VdfCardLineBrush}"
                          BorderThickness="1"
                          IsVisible="{Binding HasType}">
                    <TextBlock FontSize="10.5" FontWeight="Bold" LetterSpacing="0.6" Opacity="{DynamicResource VdfTextFaintOpacity}"
                               Text="{Binding TypeLabel}" />
                  </Border>
                </StackPanel>
                <ProgressBar Grid.Column="1" Height="7" CornerRadius="3.5" Margin="14,0"
                             AutomationProperties.Name="{Binding Root}"
                             VerticalAlignment="Center"
                             Maximum="1"
                             Value="{Binding Fraction, Mode=OneWay}" />
                <TextBlock Grid.Column="2" FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}"
                           VerticalAlignment="Center" TextAlignment="Right"
                           Text="{Binding Stat}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- last few log lines (mockup .logtail): full window width, hover for the
             complete message (#836) -->
        <ItemsControl ItemsSource="{Binding LogTail}"
                      AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Tab.Log]}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="data:LogTailRow">
              <TextBlock FontSize="11.5" Opacity="{DynamicResource VdfTextFaintOpacity}" Margin="0,1.5"
                         TextTrimming="CharacterEllipsis" Text="{Binding Display}">
                <ToolTip.Tip>
                  <TextBlock MaxWidth="800" TextWrapping="Wrap" Text="{Binding Tooltip}" />
                </ToolTip.Tip>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
