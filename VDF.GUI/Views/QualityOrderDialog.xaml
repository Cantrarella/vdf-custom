<!-- Dialog for selecting the order of quality criteria -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VDF.GUI.ViewModels"
        x:Class="VDF.GUI.Views.QualityOrderDialog"
        xmlns:app="clr-namespace:VDF.GUI;assembly=VDF.GUI"
        x:DataType="vm:QualityOrderVM"
        CanResize="false"
        MaxWidth="460"
        Icon="/Assets/icon.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        Title="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.Title]}">
    <!-- 弹窗主体走 _Dialogs.xaml 的同一套配方：窗口底色是全局 Window 规则给的页面色，
         内容装在一张 dlgcard 里，主/次按钮用 dlgprimary / dlgghost。 -->
    <Border Classes="dlgbody dlgframe"
            Margin="28"
            Background="{DynamicResource VdfCardBrush}">
    <StackPanel Spacing="12">
        <!-- The caption is gone, so the window's own name is the body's heading. -->
        <TextBlock Classes="dlgtitle"
                   Text="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.Title]}" />
        <TextBlock Classes="dlgtext"
                   Text="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.Description]}" />
        <TextBlock Classes="dlghint"
                   Text="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.CheckHint]}" />
        <Border Classes="dlglist">
            <ListBox AutomationProperties.Name="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.Title]}" x:Name="CriteriaListBox"
                     Height="300"
                     Background="Transparent"
                     ItemsSource="{Binding CriteriaOrder}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, x:DataType=vm:QualityCriterionOption}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:QualityCriterionOption">
                        <!-- The list is the Tab stop; Space on the selected row toggles the box. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox AutomationProperties.Name="{Binding Display}"
                                      MinWidth="0"
                                      Padding="0"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      IsTabStop="False"
                                      IsChecked="{Binding IsEnabled}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Classes="dlgghost"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.BtnMoveUp]}"
                    Command="{Binding MoveUpCommand}"
                    CommandParameter="{Binding ElementName=CriteriaListBox, Path=SelectedIndex}" />
            <Button Grid.Column="1"
                    Classes="dlgghost"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[QualityOrderDialog.BtnMoveDown]}"
                    Command="{Binding MoveDownCommand}"
                    CommandParameter="{Binding ElementName=CriteriaListBox, Path=SelectedIndex}" />
            <Button Grid.Column="3"
                    Classes="dlgprimary"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[Dialog.OK]}"
                    IsDefault="True"
                    Click="Ok_Click" />
            <Button Grid.Column="4"
                    Classes="dlgghost"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[Dialog.Cancel]}"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </Grid>
    </StackPanel>
    </Border>
</Window>
