<!-- No caption (WindowDecorations=BorderOnly) *and* the client area extended over the
     frame: without the second half, Windows paints an ~8px band above the client area of a
     resizable window in the system's own border colour - pure white on a light Windows, which
     is the blank strip that showed above every one of these dialogs in the dark theme. The
     extended part is ours to paint, so the band becomes the window's own surface. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:vm="clr-namespace:VDF.GUI.ViewModels"
        xmlns:app="clr-namespace:VDF.GUI;assembly=VDF.GUI"
        x:Class="VDF.GUI.Views.BlacklistManagerView"
        x:DataType="vm:BlacklistManagerVM"
        Width="640"
        Height="480"
        MinWidth="420"
        MinHeight="320"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Title="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Title]}">
    <!-- 弹窗主体走 _Dialogs.xaml 的同一套配方（卡片 + dlgprimary/dlgghost + dlglist），
         窗口底色由全局 Window 规则给。 -->
    <Border Classes="dlgbody dlgframe"
            Margin="28"
            Background="{DynamicResource VdfCardBrush}">
    <DockPanel>
        <!-- The caption is gone, so the window's own name is the body's heading. -->
        <TextBlock DockPanel.Dock="Top"
                   Classes="dlgtitle"
                   Text="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Title]}"
                   Margin="0,0,0,10" />
        <TextBlock DockPanel.Dock="Top"
                   Classes="dlghint"
                   Text="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Description]}"
                   Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding GroupCountText}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <!-- Empty-state hint -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Empty]}"
                   IsVisible="{Binding IsEmpty}"
                   Opacity="{DynamicResource VdfTextMutedOpacity}"
                   FontStyle="Italic"
                   Margin="0,0,0,8" />

        <!-- Status / result message -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Opacity="{DynamicResource VdfTextMutedOpacity}"
                   Margin="0,8,0,0" />

        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Classes="dlgghost"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.UnmarkSelected]}"
                    Command="{Binding UnmarkSelectedCommand}"
                    CommandParameter="{Binding ElementName=EntriesListBox, Path=SelectedItems}" />
            <Button Classes="dlgghost"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.PruneMissing]}"
                    ToolTip.Tip="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.PruneMissingTooltip]}"
                    Command="{Binding PruneMissingFilesCommand}" />
            <Button Classes="dlgghost"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[Dialog.ClearAll]}"
                    Command="{Binding ClearAllCommand}" />
            <Button Classes="dlgprimary"
                    Content="{Binding Source={x:Static app:App.Lang}, Path=[Dialog.Close]}"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>

        <!-- Entries list -->
        <Border Classes="dlglist">
            <ListBox AutomationProperties.Name="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Title]}" x:Name="EntriesListBox"
                     Background="Transparent"
                     ItemsSource="{Binding Entries}"
                     SelectionMode="Multiple">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BlacklistEntryVM">
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding PathsDisplay}"
                                       FontFamily="Consolas, Menlo, monospace"
                                       FontSize="12"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
    </Border>
</Window>
