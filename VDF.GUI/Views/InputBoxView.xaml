<Window
    x:Class="VDF.GUI.Views.InputBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="using:VDF.GUI.ViewModels"
    x:DataType="vm:InputBoxVM"
    Title="{Binding Title}"
    MinWidth="400"
    Width="400"
    MaxWidth="600"
    CanResize="false"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None">
    <!-- The dialog's card and its buttons come from Styles/_Dialogs.xaml, the same recipes
         the pages use; the window's own tint is set there too. -->
    <Border Classes="dlgbody dlgframe"
            Margin="28"
            Background="{DynamicResource VdfCardBrush}">
        <StackPanel Spacing="14">
            <TextBlock Classes="dlgtext" Text="{Binding Message}" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding HasReadOnlyInfo}" Spacing="2">
                <TextBlock Classes="dlghint" Text="{Binding Source={x:Static local:App.Lang}, Path=[InputBox.CurrentFile]}" />
                <SelectableTextBlock Text="{Binding ReadOnlyInfo}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox
                x:Name="TextBoxInput"
                Classes="dlgfield"
                Text="{Binding Input}"
                TextWrapping="Wrap"
                PlaceholderText="{Binding WaterMark}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Classes="dlgprimary"
                    Command="{Binding OKCommand}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.OK]}"
                    IsDefault="{Binding HasOKButton}"
                    IsVisible="{Binding HasOKButton}" />
                <Button
                    Classes="dlgprimary"
                    Command="{Binding YesCommand}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Yes]}"
                    IsDefault="{Binding HasYesButton}"
                    IsVisible="{Binding HasYesButton}" />
                <Button
                    Classes="dlgghost"
                    Command="{Binding NoCommand}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.No]}"
                    IsCancel="{Binding HasNoButton}"
                    IsVisible="{Binding HasNoButton}" />
                <Button
                    Classes="dlgghost"
                    Command="{Binding CancelCommand}"
                    Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Cancel]}"
                    IsCancel="{Binding HasCancelButton}"
                    IsVisible="{Binding HasCancelButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
