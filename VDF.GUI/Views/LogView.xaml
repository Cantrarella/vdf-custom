<UserControl
    x:Class="VDF.GUI.Views.LogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:data="clr-namespace:VDF.GUI.Data;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels;assembly=VDF.GUI"
    x:DataType="vm:MainWindowVM"
    x:Name="LogRoot">

  <UserControl.Styles>
    <Style Selector="ToggleButton.chip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <!-- mockup .btn-ghost.btn-sm: the frame is what makes a quiet command read as a
           button rather than as a word sitting next to one. -->
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfBtnGhostLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfBtnHoverLineBrush}" />
    </Style>
    <Style Selector="Button.mini:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VdfTextBrush}" />
    </Style>
    <Style Selector="ListBox.log ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- mockup .logrow: neutral dot; warn/err recolor dot, warn/err message text -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Fill" Value="#55808080" />
    </Style>
    <Style Selector="Ellipse.dot.warn">
      <Setter Property="Fill" Value="{DynamicResource VdfWarnBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.err">
      <Setter Property="Fill" Value="{DynamicResource VdfDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.lmsg.warn">
      <Setter Property="Foreground" Value="{DynamicResource VdfWarnBrush}" />
    </Style>
    <Style Selector="TextBlock.lmsg.err">
      <Setter Property="Foreground" Value="{DynamicResource VdfDangerBrush}" />
    </Style>
    <!-- mockup .lrep: small pill chip, accent on hover / while expanded -->
    <Style Selector="Button.lrep">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource VdfCardLineBrush}" />
      <Setter Property="Opacity" Value="{DynamicResource VdfTextDim80Opacity}" />
    </Style>
    <!-- The expanded chip's own frame. It sits BEFORE the pointer rules on purpose: an
         expanded chip can still be hovered, and these two rules are the same specificity,
         so whichever is written last takes the frame. Left where it used to be it would
         have handed the accent frame back on every hover and made the palette's line
         colour unreachable on exactly the chips the reader is most likely to be over -
         the same ordering trick Button.scanact.stop uses for its danger frame. -->
    <Style Selector="Button.lrep.on">
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.lrep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VdfBtnHoverBrush}" />
      <!-- The frame is set on the presenter, not on the button: the theme writes its own
           grey onto this part under the pointer, so the accent line the button was given
           never showed (measured: #A9D7F6 on the button, #9FA3AD on the part in view). -->
      <Setter Property="BorderBrush" Value="{DynamicResource VdfBtnHoverLineBrush}" />
    </Style>
    <Style Selector="Button.lrep:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VdfTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ======== Toolbar: severity chips · search · copy/save/clear (mockup .rtoolbar) ======== -->
    <Border
        Grid.Row="0"
        Padding="8,6"
        Background="{DynamicResource VdfSunkenBrush}"
        BorderBrush="{DynamicResource VdfCardLineBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
          <ToggleButton
              Classes="chip"
              IsChecked="{Binding LogFilterAllChecked, Mode=OneWay}"
              Command="{Binding SetLogFilterCommand}"
              CommandParameter="All"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Log.Filter.All]}" />
          <ToggleButton
              Classes="chip"
              Margin="6,0,0,0"
              IsChecked="{Binding LogFilterInfoChecked, Mode=OneWay}"
              Command="{Binding SetLogFilterCommand}"
              CommandParameter="Info"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Log.Filter.Info]}" />
          <ToggleButton
              Classes="chip"
              Margin="6,0,0,0"
              IsChecked="{Binding LogFilterWarningsChecked, Mode=OneWay}"
              Command="{Binding SetLogFilterCommand}"
              CommandParameter="Warnings"
              Content="{Binding LogWarningsChipText}" />
          <ToggleButton
              Classes="chip"
              Margin="6,0,0,0"
              IsChecked="{Binding LogFilterErrorsChecked, Mode=OneWay}"
              Command="{Binding SetLogFilterCommand}"
              CommandParameter="Errors"
              Content="{Binding LogErrorsChipText}" />
          <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource VdfCardLineBrush}" />
          <TextBox
              MinWidth="180" FontSize="12"
              Text="{Binding LogSearchText}"
              PlaceholderText="{Binding Source={x:Static local:App.Lang}, Path=[Log.SearchWatermark]}" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button
              Classes="mini"
              Command="{Binding CopyLogSelectionCommand}"
              CommandParameter="{Binding #LogListBox.SelectedItems}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Log.Copy]}" />
          <Button
              Classes="mini"
              Command="{Binding SaveLogCommand}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.SaveToFile]}" />
          <Button
              Classes="mini"
              Command="{Binding ClearLogCommand}"
              Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Clear]}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ======== Log list: session separators + rows (mockup .log-list) ======== -->
    <ListBox
        AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Tab.Log]}"
        x:Name="LogListBox"
        Grid.Row="1"
        Classes="log"
        Padding="0,8"
        ItemsSource="{Binding LogRows}"
        SelectedItem="{Binding SelectedLogItem}"
        SelectionMode="Multiple"
        Background="Transparent"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ContextMenu>
        <ContextMenu Opening="LogContextMenu_Opening">
          <MenuItem
              Command="{Binding OpenLogItemLocationCommand}"
              Header="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.ContextMenu.OpenInFolder]}" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.DataTemplates>
        <!-- session separator: "Scan · today 09:41 ————————" -->
        <DataTemplate DataType="data:LogSessionRow">
          <Grid ColumnDefinitions="Auto,*" Margin="20,12,20,6">
            <TextBlock
                Grid.Column="0"
                FontSize="11.5"
                FontWeight="SemiBold"
                Opacity="{DynamicResource VdfTextMutedOpacity}"
                Text="{Binding Header}" />
            <Border
                Grid.Column="1"
                Height="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Background="{DynamicResource VdfCardLineBrush}" />
          </Grid>
        </DataTemplate>
        <!-- log row: time · dot · message · ×N chip -->
        <DataTemplate DataType="data:LogMessageRow">
          <Grid ColumnDefinitions="66,10,*,Auto" Margin="20,1.5">
            <ToolTip.Tip>
              <TextBlock MaxWidth="800" TextWrapping="Wrap" Text="{Binding TooltipMessage}" />
            </ToolTip.Tip>
            <TextBlock
                Grid.Column="0"
                FontSize="12"
                Opacity="{DynamicResource VdfTextFaintOpacity}"
                VerticalAlignment="Center"
                Text="{Binding TimeText}" />
            <Ellipse
                Grid.Column="1"
                Classes="dot"
                Classes.warn="{Binding IsWarning}"
                Classes.err="{Binding IsError}"
                Width="7" Height="7"
                Margin="0,0,3,0"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="2"
                Classes="lmsg"
                Classes.warn="{Binding IsWarning}"
                Classes.err="{Binding IsError}"
                Margin="10,0,0,0"
                FontSize="13"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Text="{Binding DisplayMessage}" />
            <Button
                Grid.Column="3"
                Classes="lrep"
                Classes.on="{Binding IsExpanded}"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding HasRepeats}"
                Command="{Binding $parent[UserControl].((vm:MainWindowVM)DataContext).ToggleLogGroupCommand}"
                CommandParameter="{Binding}"
                Content="{Binding RepeatText}"
                ToolTip.Tip="{Binding Source={x:Static local:App.Lang}, Path=[Log.ShowAllTip]}" />
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>

    <!-- ======== Status line: log file location (mockup .statusline) ======== -->
    <Border
        Grid.Row="2"
        Padding="24,6"
        BorderBrush="{DynamicResource VdfCardLineBrush}"
        BorderThickness="0,1,0,0">
      <TextBlock
          FontSize="12"
          Opacity="{DynamicResource VdfTextFaintOpacity}"
          Text="{Binding LogFileStatusText}" />
    </Border>
  </Grid>
</UserControl>
